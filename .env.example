# ─── Telegram visitor notifications + lead capture ───
# Create a bot via @BotFather, then get your chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# ─── Gemini (Solve Your Problems chatbot mode) ───
# Free tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-your-gemini-key

# These vars must be set in Vercel → Project → Settings → Environment Variables.
# The static GitHub Pages build does not have a backend; visit-tracking and Solve mode
# only function on the Vercel deployment.
