  function renderTechAreaChips(){
    const items = Object.entries(TECH_AREAS).map(([k,v])=>({
      label: v.label, onClick: ()=>startTechArea(k),
    }));
    addSolveChips(items);
  }

  function startTechArea(areaKey){
    const t=getTh(activeId); if(!t) return;
    const ss=t.solveState;
    ss.techArea = areaKey;
    ss.techAnswers = {};
    ss.techQIdx = 0;
    const area = TECH_AREAS[areaKey];
    addUser(area.label); t.messages.push({role:'user',text:area.label});
    trackAction('chat:tech-area', areaKey);
    updateChatTitle(t);
    askNextTechQuestion();
  }

  function askNextTechQuestion(){
    const t=getTh(activeId); if(!t) return;
    const ss=t.solveState;
    const area=TECH_AREAS[ss.techArea];
    const idx=ss.techQIdx||0;
    if(idx >= area.questions.length){
      // All answered → render diagnosis
      finishTechFlow();
      return;
    }
    const qObj=area.questions[idx];
    const q=`(${idx+1}/${area.questions.length}) ${qObj.q}`;
    addBot(`<p>${esc(q)}</p>`); t.messages.push({role:'bot',html:`<p>${esc(q)}</p>`});
    lockInput('Pick an answer above...');
    addSolveChips([
      { label:'✅ Yes',     onClick:()=>answerTechQ('yes') },
      { label:'❌ No',      onClick:()=>answerTechQ('no') },
      { label:'🤷 Not sure', onClick:()=>answerTechQ('unsure') },
    ]);
    save();
  }

  function answerTechQ(ans){
    const t=getTh(activeId); if(!t) return;
    const ss=t.solveState;
    const area=TECH_AREAS[ss.techArea];
    const idx=ss.techQIdx||0;
    const qObj=area.questions[idx];
    ss.techAnswers[qObj.id]=ans;
    addUser(ans==='yes'?'Yes':ans==='no'?'No':'Not sure');
    t.messages.push({role:'user',text:ans});
    trackAction('chat:tech-ans', `${qObj.id}=${ans}`);
    ss.techQIdx = idx + 1;
    setTimeout(()=>askNextTechQuestion(), 250);
    save();
  }

  function finishTechFlow(){
    const t=getTh(activeId); if(!t) return;
    const ss=t.solveState;
    const area=TECH_AREAS[ss.techArea];
    const result = area.diagnose(ss.techAnswers);
    const card=document.createElement('div');
    card.className='sv-card sv-results';
    card.innerHTML = `
      <div class="sv-card-h">${area.icon} Diagnosis — ${esc(area.label.replace(/^\S+\s/,''))}</div>
      ${result.issues.length === 0
        ? '<div style="font-size:.85rem;color:#0d8043;padding:.5rem 0">✅ No obvious issues found from these questions. The problem may be more nuanced — talk to a specialist.</div>'
        : `
        <div class="sv-results-section">
          <div class="sv-results-section-h">⚠️ Likely issues</div>
          <ul style="margin:.3rem 0 .5rem 1rem;padding:0;font-size:.82rem;line-height:1.55;color:#202124">
            ${result.issues.map(x=>`<li style="margin-bottom:.3rem">${esc(x)}</li>`).join('')}
          </ul>
        </div>
        <div class="sv-results-section">
          <div class="sv-results-section-h">🛠 What we can help you with</div>
          <ul style="margin:.3rem 0 .5rem 1rem;padding:0;font-size:.82rem;line-height:1.55;color:#202124">
            ${result.help.map(x=>`<li style="margin-bottom:.3rem">${esc(x)}</li>`).join('')}
          </ul>
        </div>`}
      <div class="sv-card-note">This is a quick diagnosis from yes/no signals. A 30-min audit with a Google Ads Solution Architect will reveal the root cause.</div>`;
    el().appendChild(card); el().scrollTop=el().scrollHeight;
    trackAction('chat:tech-diagnose', ss.techArea);

    // Lead form CTA
    setTimeout(()=>{
      addCtaButton('🤝 Get expert help from a Google Ads Solution Architect', 'secondary', ()=>{
        trackAction('chat:cta-expert-tech');
        ss.stage='lead';
        const intro="Perfect — leave your details and our Google Ads Solution Architect will reach out within 24 hours to dive into the technical setup.";
        addBot(`<p>${esc(intro)}</p>`); t.messages.push({role:'bot',html:`<p>${esc(intro)}</p>`});
        if(!ss.leadShown){ ss.leadShown=true; addLeadForm(t); }
        ss.stage='gemini';
        setTimeout(()=>{
          const followup="Or ask me follow-up technical questions — I'm here.";
          addBot(`<p>${esc(followup)}</p>`); t.messages.push({role:'bot',html:`<p>${esc(followup)}</p>`});
          unlockInput(); save();
        }, 600);
        save();
      });
      save();
    }, 700);
    save();
  }

  // ── Solve mode: progress bar (default 9 stages, +3 optional refine = 12) ──
  const SOLVE_STEPS_DEFAULT = ['init','city','industry','persona','product','competitor','results','solutions','lead'];
  const SOLVE_STEPS_REFINED = ['init','city','industry','persona','product','competitor','budget','goal','value','results','solutions','lead'];
  const SOLVE_LABELS = {
    init:'Pick your goal', city:'Choose location', industry:'Pick industry',
    persona:'Target customer', product:'Describe your business', competitor:'Competitors',
    budget:'Budget range', goal:'Conversion goal', value:'Customer value',
    currentChannels:'Current channels', painPoint:'Where it hurts',
    results:'Market & budget', solutions:'Your playbook', lead:'Talk to expert',
    tech:'Technical diagnosis',
    symptom:'Find the real problem',
  };
  // Grow flow inserts currentChannels + painPoint after industry
  const SOLVE_STEPS_GROW = ['init','city','industry','currentChannels','painPoint','persona','product','competitor','results','solutions','lead'];
  const SOLVE_STEPS_GROW_REFINED = ['init','city','industry','currentChannels','painPoint','persona','product','competitor','budget','goal','value','results','solutions','lead'];
  const SOLVE_STEPS_TECH = ['init','tech','lead'];
  const SOLVE_STEPS_SYMPTOM = ['init','symptom','lead'];
  function getSolveSteps(ss){
    if(!ss) return SOLVE_STEPS_DEFAULT;
    if(ss.intent==='tech') return SOLVE_STEPS_TECH;
    if(ss.intent==='symptom') return SOLVE_STEPS_SYMPTOM;
    if(ss.intent==='grow') return ss.refining ? SOLVE_STEPS_GROW_REFINED : SOLVE_STEPS_GROW;
    return ss.refining ? SOLVE_STEPS_REFINED : SOLVE_STEPS_DEFAULT;
  }

  // ── Persona share heuristic (approx. % of online pop) ──
  function personaShare(personaText){
    const t=(personaText||'').toLowerCase();
    if(/gen z|18-24|sinh viên/.test(t)) return 0.15;
    if(/grad|22-28|22-30/.test(t))     return 0.12;
    if(/young pro|25-35/.test(t))      return 0.17;
    if(/mid-career|35-45/.test(t))     return 0.16;
    if(/working mom/.test(t))          return 0.13;
    if(/high-net|hnw|affluent/.test(t))return 0.03;
    if(/senior|50\+/.test(t))          return 0.22;
    if(/traveler/.test(t))             return 0.10;
    if(/eco|sustain/.test(t))          return 0.08;
    if(/bargain|deal/.test(t))         return 0.25;
    if(/sme owner|small business owner/.test(t)) return 0.05;
    if(/parent.*young kid|parent of young/.test(t)) return 0.12;
    return 0.10;
  }
  // ── Competitor density adjustment ──
  function competitorAdj(competitorText){
    if(!competitorText || /^\(no competitors|^skip/i.test(competitorText)) return 1.0;
    const named = competitorText.split(/[,;]|\band\b|\bvà\b|\n/).map(s=>s.trim()).filter(s=>s.length>1).length;
    if(named>=4) return 0.7;
    if(named>=2) return 0.9;
    return 1.05;
  }

  // ── Action-level signals to Telegram ──
  function trackAction(label, extra){
    if(API_BASE===null) return;
    let sid='';
    try{ const s=JSON.parse(sessionStorage.getItem('gads-visit-session')||'null'); if(s)sid=s.id; }catch{}
    try{
      fetch('/api/track-visit',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({
        event:'action', sessionId:sid, label:label, extra:extra||'',
      })}).catch(()=>{});
    }catch{}
  }
  function updateProgress(){
    const t=getTh(activeId);
    const wrap=document.getElementById('ms-progress');
    if(!t || (t.mode||'discover')!=='solve' || !t.solveState || t.solveState.intent==='open'){
      wrap.hidden=true; return;
    }
    // Hide on init (no intent picked yet) — progress only makes sense after first choice
    if((t.solveState.stage||'init')==='init'){ wrap.hidden=true; return; }
    wrap.hidden=false;
    const ss=t.solveState;
    const steps=getSolveSteps(ss);
    const stage=ss.stage||'init';
    let idx=steps.indexOf(stage); if(idx<0)idx=0;
    if(stage==='gemini') idx=steps.length-1;
    const pct=Math.round(((idx+1)/steps.length)*100);
    document.getElementById('ms-progress-bar').style.setProperty('--p',pct+'%');
    document.getElementById('ms-progress-text').textContent=`Step ${Math.min(idx+1,steps.length)}/${steps.length} — ${SOLVE_LABELS[stage]||''}`;
  }

  // ── Combined results card: TAM, SAM, reachable, budget tiers ──
  // Realistic calc using per-industry intent rate + persona segment + competitor density.
  function reachableBreakdown(ss){
    if(!markets || !ss.cityKey || !markets.cities[ss.cityKey] || ss.cityKey==='__other__') return null;
    const c=markets.cities[ss.cityKey];
    const ind=c.industries[ss.industryKey];
    const meta=markets.industries_meta[ss.industryKey];
    if(!ind || !meta) return null;
    const onlinePop = Math.round(c.population * c.internet_penetration);
    const intentRate = meta.intent_rate || 0.10;        // industry-specific
    const personaPct = personaShare(ss.persona);         // demographic slice
    const compAdj    = competitorAdj(ss.competitors);    // 0.7-1.05
    // Active in-market buyers = online × industry intent rate
    const inMarket = Math.round(onlinePop * intentRate);
    // Persona-matched = in-market × persona share (lower bound: persona acts as a filter)
    const personaMatched = Math.round(inMarket * personaPct);
    // Final reachable after competitor density
    const reachable = Math.round(personaMatched * compAdj);
    return { onlinePop, intentRate, inMarket, personaPct, personaMatched, compAdj, reachable };
  }
  function reachablePeople(ss){
    const b = reachableBreakdown(ss);
    return b ? b.reachable : null;
  }

  // CPC × clicks-based realistic budget tiers (replaces SAM-derived formula)
  function realisticBudgetTiers(ss){
    if(!markets) return null;
    const meta = markets.industries_meta[ss.industryKey];
    if(!meta) return null;
    const cpcMid = (meta.cpc_low + meta.cpc_high) / 2;
    // City multiplier: SG/HK higher CPC, smaller VN cities lower
    const cityMult = ({ 'singapore':1.6, 'hong-kong':1.5, 'kuala-lumpur':1.2, 'bangkok':1.1, 'jakarta':1.0,
                       'ho-chi-minh-city':1.0, 'hanoi':1.0, 'da-nang':0.8, 'can-tho':0.75, 'hai-phong':0.85 }[ss.cityKey]) || 1.0;
    const adjCpc = cpcMid * cityMult;
    // Clicks/month per tier
    const tiers = [
      { name:'Starter',    clicks: 600,   kpi:'Test what works' },
      { name:'Growth',     clicks: 2500,  kpi:'Scale winners' },
      { name:'Aggressive', clicks: 8000,  kpi:'Capture share' },
    ];
    return tiers.map(t => {
      const lo = Math.round(t.clicks * adjCpc * 0.75);
      const hi = Math.round(t.clicks * adjCpc * 1.25);
      return { name: t.name, kpi: t.kpi, lo, hi, clicks: t.clicks };
    });
  }

  function addResultsCard(ss){
    if(!markets || !ss.cityKey || !ss.industryKey || ss.cityKey==='__other__') return;
    const c=markets.cities[ss.cityKey];
    const ind=c.industries[ss.industryKey];
    const meta=markets.industries_meta[ss.industryKey];
    const breakdown = reachableBreakdown(ss);
    const tiers = realisticBudgetTiers(ss) || [];

    const fmtPct = n => Math.round(n*100)+'%';
    const compTxt = breakdown.compAdj < 1 ? `${Math.round((1-breakdown.compAdj)*100)}% lower (crowded)` : breakdown.compAdj > 1 ? `${Math.round((breakdown.compAdj-1)*100)}% higher (open)` : 'neutral';

    const card=document.createElement('div');
    card.className='sv-card sv-results';
    card.innerHTML=`
      <div class="sv-card-h">📊 Your market snapshot — ${meta.icon} ${esc(meta.label)} in ${esc(c.name)}</div>

      <div class="sv-results-section">
        <div class="sv-results-section-h">Category market size <span style="text-transform:none;font-weight:400;color:#9aa0a6">(consumer transaction value, not ad spend)</span></div>
        <div class="sv-card-grid">
          <div><div class="sv-stat-l">TAM (annual)</div><div class="sv-stat-v">${fmtMoney(ind.tam)}</div></div>
          <div><div class="sv-stat-l">SAM (digital)</div><div class="sv-stat-v">${fmtMoney(ind.sam)}</div></div>
          <div><div class="sv-stat-l">YoY growth</div><div class="sv-stat-v">${(ind.growth*100).toFixed(0)}%</div></div>
        </div>
      </div>

      <div class="sv-results-section">
        <div class="sv-results-section-h">People you can realistically reach</div>
        <div class="sv-card-grid">
          <div><div class="sv-stat-l">Online users</div><div class="sv-stat-v">${(breakdown.onlinePop/1e6).toFixed(1)}M</div></div>
          <div><div class="sv-stat-l">In-market this year</div><div class="sv-stat-v">${(breakdown.inMarket/1e3).toFixed(0)}K</div></div>
          <div><div class="sv-stat-l">Persona-matched buyers</div><div class="sv-stat-v">~${(breakdown.reachable/1e3).toFixed(1)}K</div></div>
        </div>
        <div style="font-size:.7rem;color:#5f6368;margin-top:.55rem;line-height:1.5">
          <b>How we got there:</b> ${(breakdown.onlinePop/1e6).toFixed(1)}M online
          × ${fmtPct(breakdown.intentRate)} actively shopping ${meta.label.toLowerCase()} (industry rate)
          × ${fmtPct(breakdown.personaPct)} matching your persona
          × competitor density ${compTxt}
          = <b>~${(breakdown.reachable/1e3).toFixed(1)}K reachable</b>
        </div>
      </div>

      <div class="sv-results-section">
        <div class="sv-results-section-h">Realistic monthly budget tiers <span style="text-transform:none;font-weight:400;color:#9aa0a6">(CPC × clicks)</span></div>
        <div class="sv-card-grid">
          ${tiers.map(t=>`<div><div class="sv-stat-l">${t.name}</div><div class="sv-stat-v" style="font-size:.82rem">${fmtMoney(t.lo)}–${fmtMoney(t.hi)}</div><div class="sv-stat-l" style="margin-top:.2rem;text-transform:none;letter-spacing:0">${t.kpi} • ~${t.clicks.toLocaleString()} clicks/mo</div></div>`).join('')}
        </div>
        <div style="font-size:.7rem;color:#5f6368;margin-top:.55rem;line-height:1.5">
          Based on typical ${meta.label} CPC of <b>$${meta.cpc_low.toFixed(2)}–$${meta.cpc_high.toFixed(2)}</b> in this market, adjusted for city pricing.
        </div>
      </div>

      <div class="sv-card-note">⚠️ <b>Directional estimates only.</b> Your inputs that shaped these numbers: <b>industry</b> sets the in-market intent rate, <b>persona</b> filters down to your demographic slice, and <b>competitor count</b> adjusts for market crowdedness. Real numbers come from a 1-2 week Google Ads test campaign — measure actual CTR, CPC, and conversion intent in YOUR niche.</div>`;
    el().appendChild(card); el().scrollTop=el().scrollHeight;
    return { city: c.name, industry: meta.label, tam: ind.tam, sam: ind.sam, growth: ind.growth, reach: breakdown.reachable };
  }

  // ── Big CTA button ──
  function addCtaButton(label, variant, onClick){
    const wrap=document.createElement('div');
    wrap.className='sv-cta';
    const btn=document.createElement('button');
    btn.className='sv-cta-btn'+(variant==='secondary'?' secondary':'');
    btn.textContent=label;
    btn.addEventListener('click',()=>{ wrap.remove(); onClick(); });
    wrap.appendChild(btn);
    el().appendChild(wrap); el().scrollTop=el().scrollHeight;
  }

  // ── Lock/unlock input field ──
  function lockInput(placeholder){
    const row=document.querySelector('.ms-input-row');
    const inp=document.getElementById('ms-input');
    row.classList.add('locked');
    inp.placeholder = placeholder || 'Pick an option above first...';
    inp.disabled = true;
  }
  function unlockInput(){
    const row=document.querySelector('.ms-input-row');
    const inp=document.getElementById('ms-input');
    row.classList.remove('locked');
    inp.placeholder = 'Type a message...';
    inp.disabled = false;
  }

  async function solveStart(intent){
    const t=getTh(activeId); if(!t)return;
    t.solveState = t.solveState || { stage:'init', history:[] };
    t.solveState.intent = intent;
    trackAction('chat:intent', intent);

    if(intent==='open'){
      t.solveState.stage='gemini';
      updateProgress(); unlockInput();
      const greet="Tell me about your situation — what problem are you trying to solve, and what have you tried so far? Bạn có thể viết tiếng Việt nếu muốn.";
      addBot(`<p>${esc(greet)}</p>`);
      t.messages.push({role:'bot',html:`<p>${esc(greet)}</p>`});
      save(); return;
    }

    if(intent==='tech'){
      t.solveState.stage='tech'; updateProgress(); lockInput('Pick an area above...');
      const ask="Which technical area is giving you trouble? Pick one and I'll ask 5-6 yes/no questions to scope it down.";
      addBot(`<p>${esc(ask)}</p>`); t.messages.push({role:'bot',html:`<p>${esc(ask)}</p>`});
      renderTechAreaChips();
      save(); return;
    }

    if(intent==='symptom'){
      t.solveState.stage='symptom'; updateProgress(); lockInput('Pick an option above...');
      startSymptomFlow();
      save(); return;
    }

    // New order: jump straight to city
    t.solveState.stage='city'; updateProgress(); lockInput('Pick a city above...');
    const q='Great — first, which city or province are you targeting?';
    addBot(`<p>${esc(q)}</p>`);
    t.messages.push({role:'bot',html:`<p>${esc(q)}</p>`});
    renderCityChips();
    save();
  }

  // ── Grow flow: current channels chips ──
  function renderCurrentChannelsChips(){
    const items=[
      { label:'🔍 Google Search Ads',  v:'Google Search' },
      { label:'🚀 Performance Max',     v:'Performance Max' },
      { label:'📱 Meta / Facebook Ads', v:'Meta/Facebook' },
      { label:'🎵 TikTok Ads',          v:'TikTok' },
      { label:'📰 SEO / content',       v:'SEO/Content' },
      { label:'👥 Influencers',         v:'Influencers' },
      { label:'🛒 Shopee / Lazada Ads', v:'Marketplace ads' },
      { label:'❌ Nothing structured yet', v:'None yet' },
    ];
    addSolveChips(items.map(it=>({label:it.label,onClick:()=>handleGrowChoice('currentChannels',it.v)})));
  }
  function renderPainPointChips(){
    const items=[
      { label:'📉 Volume too low',         v:'Volume too low' },
      { label:'💸 Cost per lead too high', v:'Cost too high' },
      { label:'🪦 Conversion rate dropping', v:'Conversion drops' },
      { label:'😶 Audience tapped out',    v:'Audience tapped out' },
      { label:'🌀 Performance is unpredictable', v:'Unpredictable' },
      { label:'🤷 Not sure where the problem is', v:'Unknown' },
    ];
    addSolveChips(items.map(it=>({label:it.label,onClick:()=>handleGrowChoice('painPoint',it.v)})));
  }
  function handleGrowChoice(kind, value){
    const t=getTh(activeId); if(!t) return;
    const ss=t.solveState;
    if(kind==='currentChannels'){
      ss.currentChannels=value;
      addUser(value); t.messages.push({role:'user',text:value});
      trackAction('chat:grow-channels', value);
      ss.stage='painPoint'; updateProgress(); lockInput('Pick a pain point above...');
      const q="Where does it hurt the most right now? Pick the one that bites hardest:";
      addBot(`<p>${esc(q)}</p>`); t.messages.push({role:'bot',html:`<p>${esc(q)}</p>`});
      renderPainPointChips();
      save();
    } else if(kind==='painPoint'){
      ss.painPoint=value;
      addUser(value); t.messages.push({role:'user',text:value});
      trackAction('chat:grow-pain', value);
      ss.stage='persona'; updateProgress(); unlockInput();
      const q="Now describe your typical buyer TODAY — pick a persona below or describe in your own words:";
      addBot(`<p>${esc(q)}</p>`); t.messages.push({role:'bot',html:`<p>${esc(q)}</p>`});
      renderPersonaChips();
      updateChatTitle(t);
      save();
    }
  }

  // ── Auto-name the chat thread based on accumulated solveState ──
  function updateChatTitle(t){
    if(!t) return;
    const ss=t.solveState||{};
    let title='';
    if(ss.intent==='symptom'){
      title = ss.symptomLeafTitle ? `Diagnosing: ${ss.symptomLeafTitle.slice(0,30)}` : 'Finding the problem';
    } else if(ss.intent==='tech'){
      const area = ss.techArea && TECH_AREAS[ss.techArea];
      title = area ? `Fixing ${area.label.replace(/^\S+\s/,'')}` : 'Technical issue';
    } else if(ss.intent==='new-product'){
      const what = ss.product ? ss.product.split(/[,.\n]/)[0].slice(0,28) : (ss.industryName || 'new product');
      const where = ss.cityName ? ` · ${ss.cityName}` : '';
      title = `Launching ${what}${where}`;
    } else if(ss.intent==='grow'){
      const what = ss.industryName || (ss.product ? ss.product.slice(0,24) : 'campaign');
      const where = ss.cityName ? ` · ${ss.cityName}` : '';
      title = `Growing ${what}${where}`;
    } else if(ss.intent==='open'){
      // keep first-message-derived title if present
      if(!t.title){
        const firstUser = (t.messages||[]).find(m=>m.role==='user');
        title = firstUser ? firstUser.text.slice(0,32) : 'Open chat';
      } else return;
    }
    if(title && title !== t.title){
      t.title = title.length>32 ? title.slice(0,32)+'…' : title;
      renderSB();
    }
  }

  function renderCityChips(){
    if(!markets) return;
    const items = Object.entries(markets.cities).map(([k,v])=>({
      label:'📍 '+v.name, onClick:()=>handleSolveChoice('city',k)
    }));
    items.push({ label:'🌏 Other / not listed', onClick:()=>handleSolveChoice('city','__other__') });
    addSolveChips(items);
  }
  function renderIndustryChips(){
    if(!markets) return;
    const items = Object.entries(markets.industries_meta).map(([k,v])=>({
      label:`${v.icon} ${v.label}`, onClick:()=>handleSolveChoice('industry',k)
    }));
    addSolveChips(items);
  }

  function handleSolveChoice(kind, value){
    const t=getTh(activeId); if(!t)return;
    const ss=t.solveState;
    if(kind==='city'){
      ss.cityKey=value;
      ss.cityName = (value==='__other__'?'Other':(markets&&markets.cities[value]?markets.cities[value].name:value));
      addUser(ss.cityName); t.messages.push({role:'user',text:ss.cityName});
      trackAction('chat:city', ss.cityName);
      ss.stage='industry'; updateProgress(); lockInput('Pick an industry above...');
      const q='Which industry best fits your business?';
      addBot(`<p>${esc(q)}</p>`); t.messages.push({role:'bot',html:`<p>${esc(q)}</p>`});
      renderIndustryChips();
      updateChatTitle(t);
      save();
    } else if(kind==='industry'){
      ss.industryKey=value;
      ss.industryName = markets.industries_meta[value]?.label || value;
      addUser(ss.industryName); t.messages.push({role:'user',text:ss.industryName});
      trackAction('chat:industry', ss.industryName);
      // Branch by intent: grow → currentChannels; new-product → persona
      if(ss.intent==='grow'){
        ss.stage='currentChannels'; updateProgress(); lockInput('Pick a channel above...');
        const q="What's currently running for you? Pick the main channel(s) you depend on right now:";
        addBot(`<p>${esc(q)}</p>`); t.messages.push({role:'bot',html:`<p>${esc(q)}</p>`});
        renderCurrentChannelsChips();
      } else {
        ss.stage='persona'; updateProgress(); unlockInput();
        const q='Who is your ideal customer? Pick a persona below or describe in your own words.';
        addBot(`<p>${esc(q)}</p>`); t.messages.push({role:'bot',html:`<p>${esc(q)}</p>`});
        renderPersonaChips();
      }
      updateChatTitle(t);
      save();
    }
  }

  // Persona library — quick-select chips (expanded)
  function renderPersonaChips(){
    const personas=[
      { label:'🎓 Gen Z student (18-24)',     value:'Gen Z students aged 18-24, price-sensitive, mobile-first, value brand authenticity and social proof, discover via TikTok/Instagram' },
      { label:'🎒 University grad (22-28)',   value:'Recent university graduates aged 22-28, starting careers, building independence, willing to invest in self-improvement' },
      { label:'💼 Young professional (25-35)',value:'Urban young professionals aged 25-35, mid-to-high income, career-focused, willing to pay for quality and time savings' },
      { label:'👔 Mid-career (35-45)',         value:'Mid-career professionals aged 35-45, established income, focused on family and lifestyle quality, brand-loyal' },
      { label:'👩 Working mom (25-40)',        value:'Working mothers aged 25-40, time-poor, value convenience and family safety, decide based on reviews and recommendations' },
      { label:'🧒 Parent of young kids',       value:'Parents of children under 12, prioritize safety and education, research extensively before purchase' },
