  // ── Solve mode: render lead form ──
  function addLeadForm(t){
    const form=document.createElement('div');
    form.className='sv-form';
    form.innerHTML=`
      <div class="sv-form-h">🤝 Let's connect you with a specialist</div>
      <div class="sv-form-sub">Leave your info and we'll reach out within 24h. No spam.</div>
      <input type="text" id="lf-name" placeholder="Your name *" />
      <input type="text" id="lf-contact" placeholder="Email or phone *" />
      <input type="text" id="lf-business" placeholder="Business / product (optional)" />
      <textarea id="lf-notes" placeholder="Anything else we should know? (optional)"></textarea>
      <button class="sv-form-btn" id="lf-submit">Send</button>`;
    el().appendChild(form); el().scrollTop=el().scrollHeight;

    form.querySelector('#lf-submit').addEventListener('click', async ()=>{
      const name=form.querySelector('#lf-name').value.trim();
      const contact=form.querySelector('#lf-contact').value.trim();
      const business=form.querySelector('#lf-business').value.trim();
      const notes=form.querySelector('#lf-notes').value.trim();
      if(!name||!contact){ showNotice('Name and contact required'); return; }
      const btn=form.querySelector('#lf-submit'); btn.disabled=true; btn.textContent='Sending...';

      if(API_BASE===null){
        // Static deploy — fake success
        form.innerHTML='<div class="sv-form-ok">✓ Thanks! (demo mode — backend disabled)</div>';
        return;
      }
      try{
        const ss=t.solveState||{};
        const r=await fetch('/api/lead-submit',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({
          name, contact, business, notes,
          city: ss.cityName||'', industry: ss.industryName||'',
          conversation: (ss.history||[]).map(h=>({role:h.role,text:h.text})),
        })});
        const d=await r.json();
        if(d.ok){ form.innerHTML='<div class="sv-form-ok">✓ Thanks! We\'ll reach out within 24h.</div>'; }
        else { btn.disabled=false; btn.textContent='Send'; showNotice('Submit failed — try again'); }
      }catch(e){
        btn.disabled=false; btn.textContent='Send'; showNotice('Network error');
      }
    });
  }

  // ── Streaming bot response ──
  async function addBotStream(raw, opts={}){
    const b=document.createElement('div');
    b.className='bub-bot'+(lastWho!=='bot'?' bub-gap':'');
    lastWho='bot';
    b.innerHTML='<span class="st"></span><span class="sc"></span>';
    el().appendChild(b);

    const tgt=b.querySelector('.st'), cur=b.querySelector('.sc');
    const words=raw.split(/(\s+)/); let acc='';
    for(let i=0;i<words.length;i++){
      acc+=words[i]; tgt.innerHTML=md(acc);
      el().scrollTop=el().scrollHeight;
      if(words[i].trim()) await new Promise(r=>setTimeout(r,14+Math.random()*10));
    }
    cur.remove();

    let extra='';
    if(opts.links?.length) extra+='<div class="bub-links">'+opts.links.map(l=>`<a href="${l.url}" class="bub-link" target="_blank" rel="noopener">${esc(l.text)}</a>`).join('')+'</div>';
    if(opts.related?.length) extra+='<div class="bub-related">'+opts.related.map(r=>`<button class="bub-rel-btn" data-q="${esc(r.question)}">${esc(r.question)}</button>`).join('')+'</div>';
    b.innerHTML=md(raw)+extra;
    el().scrollTop=el().scrollHeight;
