  // ── Call /api/personalize to get AI-tailored "why" sentences ──
  async function personalizeSolutions(ss){
    if(API_BASE===null) return null;
    const picks = pickSolutions(ss);
    const pickedKeys = picks.map(p=>p.k);
    const catalogHints = {};
    pickedKeys.forEach(k=>{ catalogHints[k] = SOLUTIONS_CATALOG[k].name + ' — ' + SOLUTIONS_CATALOG[k].tag; });
    try{
      const r=await fetch('/api/personalize',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({
        intent: ss.intent, cityName: ss.cityName, industryName: ss.industryName,
        persona: ss.persona, product: ss.product, competitors: ss.competitors,
        marketData: ss.marketData, pickedKeys, catalogHints,
        refinedBudget: ss.refinedBudget || '', refinedGoal: ss.refinedGoal || '', refinedValue: ss.refinedValue || '',
      })});
      const d=await r.json();
      if(!d.ok || d.fallback) return null;
      // Merge AI rationales into picks (preserve order)
      const merged = pickedKeys.map(k=>{
        const aiItem = (d.solutions||[]).find(s=>s.key===k);
        const baseWhy = picks.find(p=>p.k===k)?.why || '';
        return { k, why: aiItem?.why || baseWhy };
      });
      return { picks: merged, intro: d.intro || '', insight: d.insight || '' };
    }catch{ return null; }
  }

