  // ── Solve mode: add chips with custom labels + payloads ──
  function addSolveChips(items, idAttr){
    const wrap=document.createElement('div');
    wrap.className='bub-chips';
    if(idAttr) wrap.id=idAttr;
    items.forEach(it=>{
      const c=document.createElement('button');
