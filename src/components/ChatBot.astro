  function startSymptomFlow(){
    const t=getTh(activeId); if(!t) return;
    t.solveState.symptomNode = '__root__';
    renderSymptomNode('__root__');
    save();
  }

  function renderSymptomNode(nodeKey){
    const t=getTh(activeId); if(!t) return;
    const ss=t.solveState;
    ss.symptomNode = nodeKey;
    const node = SYMPTOM_TREE[nodeKey];
    if(!node){ console.warn('symptom node not found',nodeKey); return; }

    if(node.type === 'leaf'){
      renderSymptomLeaf(node);
      return;
    }

    // Root or branch node
    if(node.intro){
      addBot(`<p>${esc(node.intro)}</p>`);
      t.messages.push({role:'bot',html:`<p>${esc(node.intro)}</p>`});
    }
    if(node.paraphrase){
      addMirror(node.paraphrase);
    }
    if(node.analogy){
      addAnalogy(node.analogy.h, node.analogy.t);
    }
    if(node.question){
      addBot(`<p>${esc(node.question)}</p>`);
      t.messages.push({role:'bot',html:`<p>${esc(node.question)}</p>`});
    }
    addSolveChips(node.chips.map(c=>({
      label: c.label,
      onClick: ()=>{
        addUser(c.label.replace(/^\S+\s/,''));
        t.messages.push({role:'user',text:c.label});
        trackAction('chat:symptom-pick', `${nodeKey}->${c.next}`);
        setTimeout(()=>renderSymptomNode(c.next), 300);
      },
    })));
    lockInput('Pick an option above...');
    save();
  }

  function renderSymptomLeaf(node){
    const t=getTh(activeId); if(!t) return;
    const ss=t.solveState;
    ss.symptomLeafTitle = node.title;
    trackAction('chat:symptom-leaf', node.title.slice(0,40));
    updateChatTitle(t);

    const card=document.createElement('div');
    card.className='sv-card sv-results';
    const baseUrl = import.meta.env.BASE_URL;
    const caseUrl = node.case ? `${baseUrl}success-story/${node.case.id}` : null;
    card.innerHTML=`
      <div class="sv-card-h">🎯 We found your root cause</div>
      <div class="sv-results-section">
        <div class="sv-results-section-h">The real problem</div>
        <div style="font-weight:600;color:#202124;font-size:0.95rem;margin-bottom:.4rem">${esc(node.title)}</div>
        <div style="font-size:.82rem;color:#3c4043;line-height:1.6">${esc(node.eli5)}</div>
      </div>
      <div class="sv-results-section">
        <div class="sv-results-section-h">What to do next</div>
        <ol style="margin:.3rem 0 0 1.1rem;padding:0;font-size:.82rem;line-height:1.6;color:#202124">
          ${node.fix.map(s=>`<li style="margin-bottom:.3rem">${esc(s)}</li>`).join('')}
        </ol>
      </div>
      ${node.case ? `
      <div class="sv-case">
        📚 <b>How someone like you solved it:</b> ${esc(node.case.why)}
        ${caseUrl ? `<br><a href="${caseUrl}" target="_blank" rel="noopener">Read the full case study →</a>` : ''}
      </div>` : ''}
    `;
    el().appendChild(card); el().scrollTop=el().scrollHeight;
    t.messages.push({role:'bot',html:card.outerHTML});

    // Mirror checkpoint — confirm we got it right
    setTimeout(()=>{
      addMirror("Before we go further — does this match what you're actually experiencing? If not, we can back up and explore another path.");
      addSolveChips([
        { label:'✅ Yes, that\'s exactly it', onClick:()=>{
          trackAction('chat:symptom-confirm','yes');
          addUser('Yes, that\'s exactly it'); t.messages.push({role:'user',text:'Yes'});
          setTimeout(()=>{
            addCtaButton('🤝 Get expert help from a Google Ads Solution Architect','secondary',()=>{
              trackAction('chat:cta-expert-symptom');
              ss.stage='lead';
              const intro="Perfect — leave your details and our Google Ads Solution Architect will walk you through fixing this in a free 30-min call.";
              addBot(`<p>${esc(intro)}</p>`); t.messages.push({role:'bot',html:`<p>${esc(intro)}</p>`});
              if(!ss.leadShown){ ss.leadShown=true; addLeadForm(t); }
              ss.stage='gemini';
              setTimeout(()=>{
                const followup="Or ask me follow-up questions about this fix — I'm here.";
                addBot(`<p>${esc(followup)}</p>`); t.messages.push({role:'bot',html:`<p>${esc(followup)}</p>`});
                unlockInput(); save();
              }, 600);
              save();
            });
            save();
          }, 400);
        }},
        { label:'🔄 Not quite — let me try a different path', onClick:()=>{
          trackAction('chat:symptom-confirm','restart');
          addUser('Let me try a different path'); t.messages.push({role:'user',text:'Restart'});
          setTimeout(()=>renderSymptomNode('__root__'), 300);
        }},
      ]);
      save();
    }, 600);
    save();
  }

