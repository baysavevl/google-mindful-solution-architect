      }catch(e){
        btn.disabled=false; btn.textContent='Send'; showNotice('Network error');
      }
    });
  }

  // ── Streaming bot response ──
  async function addBotStream(raw, opts={}){
    const b=document.createElement('div');
    b.className='bub-bot'+(lastWho!=='bot'?' bub-gap':'');
    lastWho='bot';
    b.innerHTML='<span class="st"></span><span class="sc"></span>';
    el().appendChild(b);

    const tgt=b.querySelector('.st'), cur=b.querySelector('.sc');
    const words=raw.split(/(\s+)/); let acc='';
    for(let i=0;i<words.length;i++){
      acc+=words[i]; tgt.innerHTML=md(acc);
      el().scrollTop=el().scrollHeight;
      if(words[i].trim()) await new Promise(r=>setTimeout(r,14+Math.random()*10));
    }
    cur.remove();

    let extra='';
    if(opts.links?.length) extra+='<div class="bub-links">'+opts.links.map(l=>`<a href="${l.url}" class="bub-link" target="_blank" rel="noopener">${esc(l.text)}</a>`).join('')+'</div>';
    if(opts.related?.length) extra+='<div class="bub-related">'+opts.related.map(r=>`<button class="bub-rel-btn" data-q="${esc(r.question)}">${esc(r.question)}</button>`).join('')+'</div>';
    b.innerHTML=md(raw)+extra;
    el().scrollTop=el().scrollHeight;
    b.querySelectorAll('.bub-rel-btn').forEach(x=>x.addEventListener('click',()=>handleQ(x.dataset.q)));
  }

  function showTyping(){
    const b=document.createElement('div'); b.className='bub-typing'; b.id='typing';
    b.innerHTML='<div class="td"><span></span><span></span><span></span></div>';
    lastWho='bot'; el().appendChild(b); el().scrollTop=el().scrollHeight;
  }
  function hideTyping(){document.getElementById('typing')?.remove()}

  // ── Sidebar ──
  function renderSB(){
    const list=document.getElementById('ms-threads'), cnt=document.getElementById('ms-count');
    list.innerHTML=''; cnt.textContent=`${threads.length} / ${MAX}`;
    for(const t of threads){
      const d=document.createElement('div'); d.className='ms-th'+(t.id===activeId?' on':'');
      d.innerHTML=`<span class="ms-th-t">${esc(t.title||'New chat')}</span><button class="ms-th-x">&times;</button>`;
      d.querySelector('.ms-th-t').addEventListener('click',()=>switchTh(t.id));
      d.querySelector('.ms-th-x').addEventListener('click',e=>{e.stopPropagation();delTh(t.id)});
      list.appendChild(d);
    }
  }

  function getTh(id){return threads.find(t=>t.id===id)}
  function currentMode(){const t=getTh(activeId);return (t&&t.mode)||'discover'}
  function newTh(mode){
    mode = mode || 'solve';
    if(threads.length>=MAX){showNotice(`Max ${MAX} chats. Delete one to create a new chat.`);return}
    const t={id:gid(),title:'',messages:[],ts:Date.now(),mode:mode,solveState:{stage:'init',history:[]}};
    threads.push(t);activeId=t.id;
    save();renderChat();renderSB();syncTabs();updateProgress();
    if(mode==='solve') lockInput('Pick a goal above to start...'); else unlockInput();
    document.getElementById('ms-input').focus();
  }
  function syncTabs(){
    const m=currentMode();
    document.getElementById('ms-tab-discover').classList.toggle('on',m==='discover');
    document.getElementById('ms-tab-solve').classList.toggle('on',m==='solve');
  }
  function switchMode(mode){
    const t=getTh(activeId);
    if(t && (t.mode||'discover')===mode){ syncTabs(); return; }
    const existing = threads.find(x=>(x.mode||'discover')===mode);
    if(existing){
      activeId=existing.id; save(); renderChat(); renderSB(); syncTabs(); updateProgress();
      const ss=existing.solveState||{};
      if(mode==='solve' && ss.stage==='init') lockInput('Pick a goal above to start...');
      else if(mode==='solve' && (ss.stage==='city'||ss.stage==='industry')) lockInput('Pick an option above...');
      else unlockInput();
    }
    else { newTh(mode); }
  }
  function delTh(id){
    threads=threads.filter(t=>t.id!==id);
    if(activeId===id){if(threads.length)activeId=threads[0].id;else{const t={id:gid(),title:'',messages:[],ts:Date.now()};threads.push(t);activeId=t.id}}
    save();renderChat();renderSB();
  }
  function switchTh(id){if(id===activeId)return;activeId=id;renderChat();renderSB()}

  function renderChat(){
    el().innerHTML=''; lastWho=null;
    const t=getTh(activeId);
    const mode=(t&&t.mode)||'discover';
    if(!t||!t.messages.length){
      if(mode==='solve'){
        addBot('<p>Hi! I\'m here to help you <strong>solve a real business problem</strong> with Google Ads. Tell me what\'s on your mind — in any language. Or pick one to start:</p>');
        renderSolveInitChips();
      } else {
        addBot('<p>Hi! I\'m your <strong>Google Ads Solutions Architect</strong>. Ask me about campaigns, bidding, tracking, optimization, or success stories.</p>');
        addChips();
      }
    } else {
      for(const m of t.messages){if(m.role==='user')addUser(m.text);else addBot(m.html)}
    }
  }

  // ── Solve mode: initial intent chips ──
  function renderSolveInitChips(){
    addSolveChips([
      { label:'📱 Market my new app/service', onClick:()=>solveStart('new-product') },
      { label:'📈 Grow my existing business',   onClick:()=>solveStart('grow') },
      { label:'🔧 Optimize my campaigns',    onClick:()=>solveStart('optimize') },
      { label:'💬 Other — describe in your own words', onClick:()=>solveStart('open') },
    ],'init-chips');
  }

  // ── Solve mode: progress bar (default 9 stages, +3 optional refine = 12) ──
  const SOLVE_STEPS_DEFAULT = ['init','city','industry','persona','product','competitor','results','solutions','lead'];
  const SOLVE_STEPS_REFINED = ['init','city','industry','persona','product','competitor','budget','goal','value','results','solutions','lead'];
  const SOLVE_LABELS = {
    init:'Pick your goal', city:'Choose location', industry:'Pick industry',
    persona:'Target customer', product:'Describe your business', competitor:'Competitors',
    budget:'Budget range', goal:'Conversion goal', value:'Customer value',
    results:'Market & budget', solutions:'Your playbook', lead:'Talk to expert',
  };
  function getSolveSteps(ss){ return ss && ss.refining ? SOLVE_STEPS_REFINED : SOLVE_STEPS_DEFAULT; }

  // ── Persona share heuristic (approx. % of online pop) ──
  function personaShare(personaText){
    const t=(personaText||'').toLowerCase();
    if(/gen z|18-24|sinh viên/.test(t)) return 0.15;
    if(/grad|22-28|22-30/.test(t))     return 0.12;
    if(/young pro|25-35/.test(t))      return 0.17;
    if(/mid-career|35-45/.test(t))     return 0.16;
    if(/working mom/.test(t))          return 0.13;
    if(/high-net|hnw|affluent/.test(t))return 0.03;
    if(/senior|50\+/.test(t))          return 0.22;
    if(/traveler/.test(t))             return 0.10;
    if(/eco|sustain/.test(t))          return 0.08;
    if(/bargain|deal/.test(t))         return 0.25;
    if(/sme owner|small business owner/.test(t)) return 0.05;
    if(/parent.*young kid|parent of young/.test(t)) return 0.12;
    return 0.10;
  }
  // ── Competitor density adjustment ──
  function competitorAdj(competitorText){
    if(!competitorText || /^\(no competitors|^skip/i.test(competitorText)) return 1.0;
    const named = competitorText.split(/[,;]|\band\b|\bvà\b|\n/).map(s=>s.trim()).filter(s=>s.length>1).length;
    if(named>=4) return 0.7;
    if(named>=2) return 0.9;
    return 1.05;
  }

  // ── Action-level signals to Telegram ──
  function trackAction(label, extra){
    if(API_BASE===null) return;
    let sid='';
    try{ const s=JSON.parse(sessionStorage.getItem('gads-visit-session')||'null'); if(s)sid=s.id; }catch{}
    try{
      fetch('/api/track-visit',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({
        event:'action', sessionId:sid, label:label, extra:extra||'',
      })}).catch(()=>{});
    }catch{}
  }
  function updateProgress(){
    const t=getTh(activeId);
    const wrap=document.getElementById('ms-progress');
    if(!t || (t.mode||'discover')!=='solve' || !t.solveState || t.solveState.intent==='open'){
      wrap.hidden=true; return;
    }
    wrap.hidden=false;
    const ss=t.solveState;
    const steps=getSolveSteps(ss);
    const stage=ss.stage||'init';
    let idx=steps.indexOf(stage); if(idx<0)idx=0;
    if(stage==='gemini') idx=steps.length-1;
    const pct=Math.round(((idx+1)/steps.length)*100);
    document.getElementById('ms-progress-bar').style.setProperty('--p',pct+'%');
    document.getElementById('ms-progress-text').textContent=`Step ${Math.min(idx+1,steps.length)}/${steps.length} — ${SOLVE_LABELS[stage]||''}`;
  }

  // ── Combined results card: TAM, SAM, reachable, budget tiers ──
  // Now factors persona segment + competitor density.
  function reachablePeople(ss){
    if(!markets || !ss.cityKey || !markets.cities[ss.cityKey]) return null;
    const c=markets.cities[ss.cityKey];
    const ind=c.industries[ss.industryKey];
    if(!ind) return null;
    const onlinePop = c.population * c.internet_penetration;
    const interestShare = 0.10;                  // ~10% category interest
    const personaPct   = personaShare(ss.persona); // demographic slice
    const compAdj      = competitorAdj(ss.competitors);
    // Reachable = online × interest × persona × competitor adjustment
    // Note: persona × interest both gate the slice; we blend rather than multiply twice
    const blendedShare = Math.max(0.02, (interestShare + personaPct) / 2);
    return Math.round(onlinePop * blendedShare * compAdj);
  }

  function addResultsCard(ss){
    if(!markets || !ss.cityKey || !ss.industryKey || ss.cityKey==='__other__') return;
    const c=markets.cities[ss.cityKey];
    const ind=c.industries[ss.industryKey];
    const meta=markets.industries_meta[ss.industryKey];
    const reach=reachablePeople(ss);
    const baseMonthly = ind.sam * 0.0002 / 12;
    const tiers = [
      { name:'Starter',    mult: 0.4, kpi:'Test what works' },
      { name:'Growth',     mult: 1.0, kpi:'Scale winners' },
      { name:'Aggressive', mult: 2.5, kpi:'Capture share' },
    ];
    const card=document.createElement('div');
    card.className='sv-card sv-results';
    card.innerHTML=`
      <div class="sv-card-h">📊 Your market snapshot — ${meta.icon} ${esc(meta.label)} in ${esc(c.name)}</div>

      <div class="sv-results-section">
        <div class="sv-results-section-h">Market size</div>
        <div class="sv-card-grid">
          <div><div class="sv-stat-l">TAM (annual)</div><div class="sv-stat-v">${fmtMoney(ind.tam)}</div></div>
          <div><div class="sv-stat-l">SAM (digital)</div><div class="sv-stat-v">${fmtMoney(ind.sam)}</div></div>
          <div><div class="sv-stat-l">YoY growth</div><div class="sv-stat-v">${(ind.growth*100).toFixed(0)}%</div></div>
        </div>
      </div>

      <div class="sv-results-section">
        <div class="sv-results-section-h">People you can reach</div>
        <div class="sv-card-grid">
          <div><div class="sv-stat-l">City population</div><div class="sv-stat-v">${(c.population/1e6).toFixed(1)}M</div></div>
          <div><div class="sv-stat-l">Online users</div><div class="sv-stat-v">${(c.population*c.internet_penetration/1e6).toFixed(1)}M</div></div>
          <div><div class="sv-stat-l">Reachable buyers*</div><div class="sv-stat-v">~${(reach/1e3).toFixed(0)}K</div></div>
        </div>
      </div>

      <div class="sv-results-section">
        <div class="sv-results-section-h">Suggested monthly budget tiers</div>
        <div class="sv-card-grid">
          ${tiers.map(t=>{
            const lo=Math.round(baseMonthly*t.mult*0.7);
            const hi=Math.round(baseMonthly*t.mult*1.3);
            return `<div><div class="sv-stat-l">${t.name}</div><div class="sv-stat-v" style="font-size:.82rem">${fmtMoney(lo)}–${fmtMoney(hi)}</div><div class="sv-stat-l" style="margin-top:.2rem;text-transform:none;letter-spacing:0">${t.kpi}</div></div>`;
          }).join('')}
        </div>
      </div>

      <div class="sv-card-note">⚠️ <b>Quick estimate from a basic calculator</b> — directional only. *Reachable buyers ≈ blend of category interest + your selected persona segment, adjusted for competitor density. To get the real picture, layer in social listening, competitor research, and a 1-2 week Google Ads test campaign to measure actual CTR, CPC, and intent in your niche.</div>`;
    el().appendChild(card); el().scrollTop=el().scrollHeight;
    return { city: c.name, industry: meta.label, tam: ind.tam, sam: ind.sam, growth: ind.growth, reach };
  }

  // ── Big CTA button ──
  function addCtaButton(label, variant, onClick){
    const wrap=document.createElement('div');
    wrap.className='sv-cta';
    const btn=document.createElement('button');
    btn.className='sv-cta-btn'+(variant==='secondary'?' secondary':'');
    btn.textContent=label;
    btn.addEventListener('click',()=>{ wrap.remove(); onClick(); });
    wrap.appendChild(btn);
    el().appendChild(wrap); el().scrollTop=el().scrollHeight;
  }

  // ── Lock/unlock input field ──
  function lockInput(placeholder){
    const row=document.querySelector('.ms-input-row');
    const inp=document.getElementById('ms-input');
    row.classList.add('locked');
    inp.placeholder = placeholder || 'Pick an option above first...';
    inp.disabled = true;
  }
  function unlockInput(){
    const row=document.querySelector('.ms-input-row');
    const inp=document.getElementById('ms-input');
    row.classList.remove('locked');
    inp.placeholder = 'Type a message...';
    inp.disabled = false;
  }

  async function solveStart(intent){
    const t=getTh(activeId); if(!t)return;
    t.solveState = t.solveState || { stage:'init', history:[] };
    t.solveState.intent = intent;
    trackAction('chat:intent', intent);

    if(intent==='open'){
      t.solveState.stage='gemini';
      updateProgress(); unlockInput();
      const greet="Tell me about your situation — what problem are you trying to solve, and what have you tried so far? Bạn có thể viết tiếng Việt nếu muốn.";
      addBot(`<p>${esc(greet)}</p>`);
      t.messages.push({role:'bot',html:`<p>${esc(greet)}</p>`});
      save(); return;
    }

    // New order: jump straight to city
    t.solveState.stage='city'; updateProgress(); lockInput('Pick a city above...');
    const q='Great — first, which city or province are you targeting?';
    addBot(`<p>${esc(q)}</p>`);
    t.messages.push({role:'bot',html:`<p>${esc(q)}</p>`});
    renderCityChips();
    save();
  }

  function renderCityChips(){
    if(!markets) return;
    const items = Object.entries(markets.cities).map(([k,v])=>({
      label:'📍 '+v.name, onClick:()=>handleSolveChoice('city',k)
    }));
    items.push({ label:'🌏 Other / not listed', onClick:()=>handleSolveChoice('city','__other__') });
    addSolveChips(items);
  }
  function renderIndustryChips(){
    if(!markets) return;
    const items = Object.entries(markets.industries_meta).map(([k,v])=>({
      label:`${v.icon} ${v.label}`, onClick:()=>handleSolveChoice('industry',k)
    }));
    addSolveChips(items);
  }

  function handleSolveChoice(kind, value){
    const t=getTh(activeId); if(!t)return;
    const ss=t.solveState;
    if(kind==='city'){
      ss.cityKey=value;
