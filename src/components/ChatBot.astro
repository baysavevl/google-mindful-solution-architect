  // Build context hint string for Gemini
  function buildContextHint(t){
    const ss=t.solveState||{};
    const parts=[];
    parts.push('stage='+ss.stage);
    if(ss.intent) parts.push('intent='+ss.intent);
    if(ss.product) parts.push('product='+ss.product);
    if(ss.cityName) parts.push('city='+ss.cityName);
    if(ss.industryName) parts.push('industry='+ss.industryName);
    if(ss.marketData) parts.push('market_data='+JSON.stringify(ss.marketData));
    if(ss.persona) parts.push('persona='+ss.persona);
    return parts.join(' | ');
  }

  async function callGemini(t, userText){
    if(API_BASE===null){
      // GH Pages — fallback message
      return "Solve mode requires the live backend. Visit the deployed Vercel site to chat with the AI.";
    }
    const ss=t.solveState||{};
    ss.history = ss.history || [];
    ss.history.push({role:'user',text:userText});
    try{
      const r=await fetch('/api/chat-solve',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({
        history: ss.history,
        contextHint: buildContextHint(t),
      })});
      const d=await r.json();
      // Server-side global/IP rate limit hit
      if(r.status===429 && d.reply){
        ss.history.push({role:'model',text:d.reply});
        return d.reply;
      }
      const reply=d.reply||"Sorry, I'm having trouble responding right now.";
      ss.history.push({role:'model',text:reply});
      return reply;
    }catch(e){
      return "Network error reaching the AI. Please try again.";
    }
  }

  // Solve mode message handler — runs scripted state machine then hands off to Gemini
  async function handleSolveQ(q){
    const t=getTh(activeId); if(!t)return;
    addUser(q); t.messages.push({role:'user',text:q});
    if(!t.title){t.title=q.length>28?q.slice(0,28)+'…':q;renderSB()}
    const chips=document.getElementById('init-chips'); if(chips)chips.remove();

    const ss = t.solveState = t.solveState || { stage:'init', history:[] };

    // Scripted progression
    if(ss.stage==='init'){
      // Treat free text as 'open' branch
      ss.intent='open'; ss.stage='gemini';
    }
    if(ss.stage==='product'){
      ss.product=q; ss.stage='city'; updateProgress(); lockInput('Pick a city above...');
      const ask='Which city or province are you targeting?';
      showTyping(); await new Promise(r=>setTimeout(r,300)); hideTyping();
      addBot(`<p>${esc(ask)}</p>`); t.messages.push({role:'bot',html:`<p>${esc(ask)}</p>`});
      renderCityChips();
      save(); return;
    }
    if(ss.stage==='persona'){
      ss.persona=q; ss.stage='competitor'; updateProgress(); unlockInput();
      const ask='Who are your top 1-3 competitors? Type their names, or tap Skip.';
      showTyping(); await new Promise(r=>setTimeout(r,250)); hideTyping();
      addBot(`<p>${esc(ask)}</p>`); t.messages.push({role:'bot',html:`<p>${esc(ask)}</p>`});
      renderCompetitorSkip();
      save(); return;
    }
    if(ss.stage==='competitor'){
      ss.competitors=q; ss.stage='solution';
      updateProgress();
      // 1) Solutions card (rule-based, no LLM)
      const intro='Based on what you shared, here are my top recommendations:';
      addBot(`<p>${esc(intro)}</p>`);
      t.messages.push({role:'bot',html:`<p>${esc(intro)}</p>`});
      addSolutionsCard(ss);
      // 2) Budget tier card from market data
      if(ss.marketData) addBudgetCard(ss.marketData);
      // 3) Lead form pops up immediately
      if(!ss.leadShown){ ss.leadShown=true; setTimeout(()=>addLeadForm(t),500); }
      // 4) Move to gemini stage so further user messages go to AI for follow-up Q&A
      ss.stage='gemini';
      const followup="Want to dive deeper into any of these? Ask me anything about budgets, targeting, creatives, or which one to start with.";
      setTimeout(()=>{
        addBot(`<p>${esc(followup)}</p>`);
        t.messages.push({role:'bot',html:`<p>${esc(followup)}</p>`});
        unlockInput();
        save();
      },800);
      save(); return;
    }
    if(ss.stage==='gemini'){
      // Rate limit check
      const rl=rlCheck();
      if(!rl.ok){
        addBot(`<p>${esc(rl.msg)}</p>`);
        t.messages.push({role:'bot',html:`<p>${esc(rl.msg)}</p>`});
        if(!ss.leadShown){ ss.leadShown=true; setTimeout(()=>addLeadForm(t),300); }
        save(); return;
      }
      rlInc('user'); rlSessionInc();

      showTyping();
      const reply = await callGemini(t, q);
      hideTyping();
      await addBotStream(reply);
      t.messages.push({role:'bot',html:md(reply)});
      // Offer lead form after a few turns or if Gemini mentions specialist
      const turnCount = (ss.history||[]).filter(h=>h.role==='model').length;
      if((turnCount>=3 || /specialist|chuyên gia|connect/i.test(reply)) && !ss.leadShown){
        ss.leadShown=true;
        setTimeout(()=>addLeadForm(t),400);
      }
      save(); return;
    }
  }

  async function handleQ(q){
    const t=getTh(activeId);if(!t)return;
    if((t.mode||'discover')==='solve'){ return handleSolveQ(q); }
    addUser(q); t.messages.push({role:'user',text:q});
    if(!t.title){t.title=q.length>28?q.slice(0,28)+'…':q;renderSB()}
    const chips=document.getElementById('init-chips');if(chips)chips.remove();

    showTyping();await new Promise(r=>setTimeout(r,200+Math.random()*250));hideTyping();

    if(!engine){const h='<p>Still loading. Try again shortly.</p>';addBot(h);t.messages.push({role:'bot',html:h});t.ts=Date.now();save();return}
    const res=engine.getResponse(q);
    await addBotStream(res.answer,{links:res.links,related:res.related});
    t.messages.push({role:'bot',html:md(res.answer)});t.ts=Date.now();save();
  }

  // ── Boot ──
  initEngine();
  initMarkets();
  threads=load();
  if(!threads.length){const t={id:gid(),title:'',messages:[],ts:Date.now(),mode:'solve',solveState:{stage:'init',history:[]}};threads.push(t)}
  // Backfill mode for legacy threads
  threads.forEach(t=>{ if(!t.mode) t.mode='discover'; if(!t.solveState) t.solveState={stage:'init',history:[]}; });
  activeId=threads[0].id; save(); renderChat(); renderSB(); syncTabs(); updateProgress();
  if((getTh(activeId).mode||'discover')==='solve' && getTh(activeId).solveState.stage==='init') lockInput('Pick a goal above to start...');

  document.getElementById('ms-new').addEventListener('click',()=>newTh(currentMode()));
  document.getElementById('ms-tab-discover').addEventListener('click',()=>switchMode('discover'));
  document.getElementById('ms-tab-solve').addEventListener('click',()=>switchMode('solve'));
  const inp=document.getElementById('ms-input'),btn=document.getElementById('ms-send');
  function sub(){const q=inp.value.trim();if(!q)return;inp.value='';handleQ(q)}
  btn.addEventListener('click',sub);
  inp.addEventListener('keydown',e=>{if(e.key==='Enter')sub()});
</script>
