    const card=document.createElement('div');
    card.className='sv-card';
    card.innerHTML=`
      <div class="sv-card-h">${meta.icon} ${esc(meta.label)} — ${esc(city.name)}</div>
      <div class="sv-card-grid">
        <div><div class="sv-stat-l">Population</div><div class="sv-stat-v">${(city.population/1e6).toFixed(1)}M</div></div>
        <div><div class="sv-stat-l">Internet reach</div><div class="sv-stat-v">${Math.round(city.internet_penetration*100)}%</div></div>
        <div><div class="sv-stat-l">TAM (annual)</div><div class="sv-stat-v">${fmtMoney(ind.tam)}</div></div>
        <div><div class="sv-stat-l">SAM (digital)</div><div class="sv-stat-v">${fmtMoney(ind.sam)}</div></div>
