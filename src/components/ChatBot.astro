  // ═══ Solutions catalog & picker (rule-based, no LLM) ═══
  const SOLUTIONS_CATALOG = {
    'pmax':     { icon:'🚀', name:'Performance Max',     tag:'Best for new launches' },
    'search':   { icon:'🔍', name:'Search Ads',          tag:'Best for high-intent demand' },
    'demand':   { icon:'✨', name:'Demand Gen',          tag:'Best for awareness & visuals' },
    'youtube':  { icon:'🎬', name:'YouTube Ads',         tag:'Best for storytelling' },
    'shopping': { icon:'🛍️', name:'Shopping Ads',        tag:'Best for e-commerce SKUs' },
    'app':      { icon:'📱', name:'App Campaigns',       tag:'Best for app installs' },
    'display':  { icon:'🖼️', name:'Display + Retargeting', tag:'Best for re-engagement' },
    'smart':    { icon:'🧠', name:'Smart Bidding upgrade', tag:'Best for optimization' },
  };

  function pickSolutions(ss){
    // Returns top 3 solution keys with reasoning, ordered by fit
    const intent = ss.intent || 'grow';
    const ind = ss.industryKey || '';
    const product = (ss.product||'').toLowerCase();
    const isApp = /\b(app|application|mobile app|ứng dụng)\b/.test(product);
    const isEcom = /\b(shop|store|ecommerce|e-commerce|sell|product|cửa hàng)\b/.test(product) || ind==='fashion' || ind==='beauty-cosmetics';

    const picks=[];
    if(intent==='new-product'){
      if(isApp) picks.push({k:'app',  why:`Your product is an app — App Campaigns drive installs across Search, YouTube, Play, and Display from one budget.`});
      picks.push({k:'pmax',           why:`Performance Max uses Google's AI to find buyers across every channel — ideal when you're learning what works for a new launch.`});
      picks.push({k:'demand',         why:`Demand Gen builds awareness with visual creatives on YouTube Shorts, Discover, and Gmail — critical when no one knows your brand yet.`});
      if(picks.length<3) picks.push({k:'search', why:`Search captures the few people already typing related queries — small budget, high intent.`});
    } else if(intent==='grow'){
      picks.push({k:'search',         why:`Your business already exists, so people are searching for you and your category — Search captures that warm demand first.`});
      picks.push({k:'pmax',           why:`Layer Performance Max to scale beyond Search and find lookalike buyers across YouTube, Display, and Discover.`});
      if(isEcom) picks.push({k:'shopping', why:`With a product catalog, Shopping ads show price + image right in results — highest CTR for retail.`});
      else       picks.push({k:'demand',   why:`Demand Gen brings new audiences into your funnel with rich visual creatives.`});
    } else if(intent==='optimize'){
      picks.push({k:'smart',          why:`Migrate to Smart Bidding (Target ROAS or Maximize Conversions) — Google's AI optimizes bids per auction using signals you can't see.`});
      picks.push({k:'search',         why:`Audit Search query reports for waste; add negative keywords; tighten match types — quick wins before scaling.`});
      picks.push({k:'display',        why:`Add a Display retargeting layer to recover the 95%+ of visitors who don't convert on first visit.`});
    } else {
      picks.push({k:'search',  why:`Start with Search to capture existing demand.`});
      picks.push({k:'pmax',    why:`Add Performance Max to expand reach efficiently.`});
      picks.push({k:'demand',  why:`Use Demand Gen for visual brand-building.`});
    }

    // Industry overrides — boost relevant solution
    if(ind==='fashion' || ind==='beauty-cosmetics'){
      if(!picks.find(p=>p.k==='demand')) picks.unshift({k:'demand', why:`${ss.industryName} is highly visual — Demand Gen on YouTube Shorts and Discover converts browsers into buyers.`});
    }
    if(ind==='real-estate'){
      if(!picks.find(p=>p.k==='display')) picks.push({k:'display', why:`Real estate buyers research for weeks — Display retargeting keeps you top-of-mind through the long decision cycle.`});
    }
    if(ind==='tourism'){
      if(!picks.find(p=>p.k==='youtube')) picks.unshift({k:'youtube', why:`Travel decisions are inspiration-driven — YouTube TrueView ads turn dreaming into booking.`});
    }

    return picks.slice(0,3);
  }

  function addSolutionsCard(ss){
    const picks=pickSolutions(ss);
    const wrap=document.createElement('div');
    wrap.className='sv-solutions';
    const cityLine = ss.cityName ? ` in <b>${esc(ss.cityName)}</b>` : '';
    wrap.innerHTML=`
      <div class="sv-sol-h">🎯 Top recommended solutions for ${esc(ss.industryName||'your business')}${cityLine}</div>
      <div class="sv-sol-grid">
        ${picks.map((p,i)=>{
          const sol=SOLUTIONS_CATALOG[p.k];
          return `<div class="sv-sol-item ${i===0?'top':''}">
            ${i===0?'<div class="sv-sol-badge">Top pick</div>':''}
            <div class="sv-sol-icon">${sol.icon}</div>
            <div class="sv-sol-name">${esc(sol.name)}</div>
            <div class="sv-sol-why">${esc(p.why)}</div>
            <div class="sv-sol-tag">${esc(sol.tag)}</div>
          </div>`;
        }).join('')}
      </div>`;
    el().appendChild(wrap); el().scrollTop=el().scrollHeight;
  }

  // Competitor stage chips (allow skip)
