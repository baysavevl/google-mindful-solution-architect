  function addUser(text){
    const b=document.createElement('div');
    b.className='bub-user'+(lastWho!=='user'?' bub-gap':'');
    b.textContent=text;
    lastWho='user';
    el().appendChild(b); el().scrollTop=el().scrollHeight;
  }

  // ── Add bot bubble (left, grey) ──
  function addBot(html, opts={}){
    const b=document.createElement('div');
    b.className='bub-bot'+(lastWho!=='bot'?' bub-gap':'');
