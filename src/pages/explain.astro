---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Plain Explainer" description="Plain Explainer — pick any Google Ads concept and see it explained for engineers, marketers, and business owners, all at once." wide={true}>

  <!-- Hero -->
  <section class="ex-hero">
    <div class="ex-gbar"><span></span><span></span><span></span><span></span></div>
    <h1>Plain <span class="ex-grad">Explainer</span></h1>
    <p class="ex-sub">Pick any Google Ads concept. See it explained for engineers, marketers, and business owners — all at once.</p>
  </section>

  <!-- Boxed concept selector -->
  <div class="ex-selector">
    <div class="ex-selector-label">Choose a concept to explore</div>
    <div class="ex-chips" id="ex-chip-row"><!-- rendered by JS --></div>
  </div>

  <!-- 3-column explanation cards -->
  <div class="ex-cards" id="ex-cards">
    <!-- Engineer -->
    <div class="ex-card ex-card-blue">
      <div class="ex-card-head ex-head-blue">
        <span class="ex-card-ico">&lt;/&gt;</span>
        <span class="ex-card-name">For Engineers</span>
        <span class="ex-card-tag">Technical</span>
      </div>
      <div class="ex-viz" id="ex-viz-eng"></div>
      <div class="ex-body" id="ex-body-eng"></div>
    </div>
    <!-- Marketer -->
    <div class="ex-card ex-card-green">
      <div class="ex-card-head ex-head-green">
        <span class="ex-card-ico">📊</span>
        <span class="ex-card-name">For Marketers</span>
        <span class="ex-card-tag">Business</span>
      </div>
      <div class="ex-viz" id="ex-viz-mkt"></div>
      <div class="ex-body" id="ex-body-mkt"></div>
    </div>
    <!-- Owner -->
    <div class="ex-card ex-card-yellow">
      <div class="ex-card-head ex-head-yellow">
        <span class="ex-card-ico">💡</span>
        <span class="ex-card-name">For Business Owners</span>
        <span class="ex-card-tag">Analogy</span>
      </div>
      <div class="ex-viz" id="ex-viz-own"></div>
      <div class="ex-body" id="ex-body-own"></div>
    </div>
  </div>

  <!-- CTA -->
  <div class="ex-cta">
    <p>Want to go deeper? Ask the chatbot any of these concepts.</p>
    <a href={base} class="ex-cta-btn">Ask the chatbot &rarr;</a>
  </div>

</BaseLayout>

<!-- ALL styles are global because chips + viz are injected by JS (Astro scoped classes won't match JS-created elements) -->
<style is:global>
  /* ── Google bar ── */
  .ex-gbar { display:flex; height:4px; border-radius:2px; overflow:hidden; max-width:80px; margin:0 auto 1.5rem; }
  .ex-gbar span { flex:1; }
  .ex-gbar span:nth-child(1){ background:#4285f4; }
  .ex-gbar span:nth-child(2){ background:#ea4335; }
  .ex-gbar span:nth-child(3){ background:#fbbc05; }
  .ex-gbar span:nth-child(4){ background:#34a853; }

  /* ── Hero ── */
  .ex-hero { text-align:center; padding:2.5rem 0 1.5rem; }
  .ex-hero h1 { font-size:2.5rem; font-weight:700; letter-spacing:-0.03em; color:#202124; margin:0 0 .75rem; }
  .ex-grad { background:linear-gradient(90deg,#4285f4,#34a853); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
  .ex-sub { font-size:1rem; color:#5f6368; max-width:560px; margin:0 auto; line-height:1.65; }

  /* ── Selector box ── */
  .ex-selector {
    background:#f8f9fa; border:1.5px solid #dadce0; border-radius:16px;
    padding:1rem 1.25rem 1.1rem; box-shadow:0 2px 8px rgba(0,0,0,.04);
    margin-bottom:1.5rem;
  }
  .ex-selector-label {
    font-size:.72rem; font-weight:700; letter-spacing:.07em;
    text-transform:uppercase; color:#5f6368; margin-bottom:.75rem;
  }

  /* ── Chips ── */
  .ex-chips { display:flex; gap:8px; flex-wrap:wrap; }
  .ex-chip {
    display:inline-flex; align-items:center;
    padding:6px 14px; border-radius:9999px;
    border:1.5px solid #dadce0;
    background:#fff; color:#202124;
    font-family:inherit; font-size:.82rem; font-weight:500;
    cursor:pointer; white-space:nowrap;
    transition:border-color .13s, background .13s, color .13s, box-shadow .13s;
    line-height:1.4;
  }
  .ex-chip:hover:not(.ex-chip-on) { border-color:#4285f4; background:#e8f0fe; color:#1a73e8; }
  .ex-chip-on { background:#4285f4; border-color:#4285f4; color:#fff; box-shadow:0 2px 8px rgba(66,133,244,.3); }

  /* ── Cards grid ── */
  .ex-cards { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-bottom:2rem; }
  @media(max-width:900px){ .ex-cards { grid-template-columns:1fr; } }

  .ex-card {
    border-radius:16px; border:1.5px solid #dadce0; background:#fff;
    overflow:hidden; display:flex; flex-direction:column;
    box-shadow:0 1px 6px rgba(0,0,0,.05);
    transition:box-shadow .2s, transform .2s;
  }
  .ex-card:hover { box-shadow:0 6px 24px rgba(0,0,0,.09); transform:translateY(-2px); }

  /* Card headers */
  .ex-card-head {
    display:flex; align-items:center; gap:8px;
    padding:13px 18px; font-weight:700; font-size:.88rem;
    letter-spacing:.01em; color:#fff;
  }
  .ex-head-blue  { background:#4285f4; }
  .ex-head-green { background:#34a853; }
  .ex-head-yellow { background:#fbbc05; color:#1a1a1a; }

  .ex-card-ico  { font-size:1.1rem; line-height:1; }
  .ex-card-name { flex:1; }
  .ex-card-tag  {
    font-size:.62rem; font-weight:700; letter-spacing:.07em;
    text-transform:uppercase; background:rgba(255,255,255,.22);
    padding:2px 7px; border-radius:100px; opacity:.9;
  }
  .ex-head-yellow .ex-card-tag { background:rgba(0,0,0,.1); color:#1a1a1a; }

  /* ── Viz area ── */
  .ex-viz {
    padding:14px 18px 10px; background:#f8f9fa;
    border-bottom:1px solid #dadce0; min-height:80px;
    display:flex; align-items:center; flex-wrap:wrap;
  }

  /* Flow diagram */
  .xflow { display:flex; align-items:flex-start; gap:6px; flex-wrap:wrap; font-size:.75rem; }
  .xnode {
    background:#fff; border:1px solid #dadce0; border-radius:8px;
    padding:5px 9px; text-align:center; line-height:1.35;
    font-weight:500; color:#202124; min-width:80px;
  }
  .xnode small { display:block; font-weight:400; color:#5f6368; font-size:.68rem; margin-top:2px; }
  .xnode-hl { border-color:#4285f4; background:#e8f0fe; color:#1a73e8; }
  .xarrow { color:#9aa0a6; font-size:1rem; font-weight:700; padding-top:6px; }

  /* Stats row */
  .xstats { display:flex; gap:8px; flex-wrap:wrap; width:100%; }
  .xstat {
    background:#fff; border:1px solid #dadce0; border-radius:8px;
    padding:6px 10px; text-align:center; flex:1; min-width:60px;
  }
  .xnum { display:block; font-size:.8rem; font-weight:700; margin-bottom:2px; }
  .xnum.g { color:#34a853; } .xnum.b { color:#4285f4; } .xnum.y { color:#f9ab00; }
  .xnum.r { color:#ea4335; } .xnum.gr { color:#5f6368; }
  .xlbl { font-size:.67rem; color:#5f6368; display:block; line-height:1.3; }

  /* Tags cloud */
  .xtags { display:flex; gap:5px; flex-wrap:wrap; }
  .xtag { font-size:.7rem; font-weight:600; padding:3px 9px; border-radius:100px; }
  .xtag.b { background:#e8f0fe; color:#1a73e8; }
  .xtag.g { background:#e6f4ea; color:#137333; }
  .xtag.y { background:#fef7e0; color:#b06000; }
  .xtag.gr { background:#f1f3f4; color:#5f6368; }

  /* Formula */
  .xformula { display:flex; align-items:center; gap:6px; flex-wrap:wrap; font-size:.82rem; font-weight:700; width:100%; }
  .xfp { padding:4px 10px; border-radius:6px; color:#fff; }
  .xfp.b { background:#4285f4; } .xfp.g { background:#34a853; }
  .xfp.y { background:#f9ab00; color:#1a1a1a; } .xfp.gr { background:#9aa0a6; }
  .xfop { color:#5f6368; font-size:1rem; }
  .xformula-note { font-size:.72rem; color:#5f6368; margin-top:5px; width:100%; text-align:center; font-weight:400; }

  /* Journey path */
  .xpath { display:flex; align-items:center; width:100%; gap:0; margin-bottom:4px; }
  .xpath-node { background:#fff; border:1px solid #dadce0; border-radius:8px; padding:4px 10px; font-size:.72rem; font-weight:500; text-align:center; flex-shrink:0; }
  .xpath-node small { display:block; color:#5f6368; }
  .xpath-conv { border-color:#34a853; background:#e6f4ea; color:#137333; }
  .xpath-line { flex:1; height:2px; background:#dadce0; }
  .xpath-note { font-size:.68rem; color:#5f6368; width:100%; text-align:center; margin-top:4px; }

  /* Scale bar */
  .xscale { width:100%; }
  .xscale-bar { height:8px; background:#e8eaed; border-radius:4px; overflow:hidden; margin-bottom:5px; }
  .xscale-fill { height:100%; background:linear-gradient(90deg,#ea4335,#fbbc05,#34a853); border-radius:4px; }
  .xscale-lbls { display:flex; justify-content:space-between; font-size:.7rem; color:#5f6368; }

  /* Analogy block */
  .xanalogy { text-align:center; width:100%; padding:4px 0; }
  .xbig { font-size:2rem; line-height:1; margin-bottom:5px; }
  .xbig-name { font-size:.8rem; font-weight:700; color:#202124; margin-bottom:3px; }
  .xbig-sub { font-size:.71rem; color:#5f6368; line-height:1.4; max-width:200px; margin:0 auto; }

  /* ── Card body text ── */
  .ex-body { padding:16px 18px; flex:1; font-size:.875rem; line-height:1.75; color:#202124; }
  .ex-body p { margin:0; }
  .ex-body code {
    font-family:'JetBrains Mono',ui-monospace,monospace;
    font-size:.8em; background:#f1f3f4; padding:.12em .4em;
    border-radius:4px; color:#d93025;
  }
  .ex-body strong { font-weight:600; color:#202124; }
  .ex-body .kw { font-weight:600; color:#1a73e8; }
  .ex-body .metric { font-weight:600; color:#137333; }
  .ex-body .analogy-lede { font-style:italic; color:#5f6368; display:block; margin-bottom:.5rem; font-size:.82rem; }

  /* ── CTA ── */
  .ex-cta { text-align:center; padding:2rem 0 1rem; border-top:1px solid #dadce0; }
  .ex-cta p { font-size:.95rem; color:#5f6368; margin-bottom:1rem; }
  .ex-cta-btn {
    display:inline-block; padding:11px 26px; border-radius:9999px;
    background:#4285f4; color:#fff; font-weight:600; font-size:.92rem;
    text-decoration:none; transition:background .15s, box-shadow .15s, transform .15s;
  }
  .ex-cta-btn:hover { background:#1a73e8; box-shadow:0 4px 16px rgba(66,133,244,.35); transform:translateY(-1px); }
</style>

<script>
  const concepts = [
    {
      id:"smart-bidding", label:"Smart Bidding",
      engViz:`<div class="xflow"><span class="xnode">Auction signals<small>device · location · intent · time</small></span><span class="xarrow">→</span><span class="xnode xnode-hl">ML Model<small>70M+ signals/auction</small></span><span class="xarrow">→</span><span class="xnode">Optimal bid<small>per auction, real-time</small></span></div>`,
      mktViz:`<div class="xstats"><div class="xstat"><span class="xnum g">↓ CPA</span><span class="xlbl">Cost per conversion</span></div><div class="xstat"><span class="xnum b">↑ Conv.</span><span class="xlbl">Conversions volume</span></div><div class="xstat"><span class="xnum gr">= Budget</span><span class="xlbl">Same spend</span></div></div>`,
      ownViz:`<div class="xanalogy"><div class="xbig">🏪</div><div class="xbig-name">The "Smart Cashier"</div><div class="xbig-sub">Knows who will buy before they do</div></div>`,
      eng:`ML model using auction-time signals — <strong>device, location, query intent, audience lists, time of day, browser</strong> — to set the optimal bid in real-time for each auction. Strategies: <code>Target CPA</code>, <code>Target ROAS</code>, <code>Maximize Conversions</code>, <code>Maximize Conversion Value</code>. Signals processed per auction: <strong>70M+</strong>.`,
      mkt:`Your bids <strong>automatically adjust</strong> based on who is searching and how likely they are to convert — so you pay more to reach <span class="metric">high-value customers</span> and less for low-probability clicks. Result: <span class="metric">better CPA with the same budget</span>.`,
      own:`<span class="analogy-lede">Imagine a store with a smart cashier...</span>They can instantly tell if a customer is a serious buyer or just browsing — and gives discounts only to the serious buyers. Smart Bidding does the same: <strong>it bids higher when someone is likely to buy, lower when they're not.</strong>`,
    },
    {
      id:"pmax", label:"Performance Max",
      engViz:`<div class="xflow"><span class="xnode">Asset Group<small>headlines · images · video</small></span><span class="xarrow">→</span><span class="xnode xnode-hl">All Google Inventory<small>Search · YT · Display · Gmail · Maps</small></span><span class="xarrow">→</span><span class="xnode">Auto-optimised<small>placement + bid + creative</small></span></div>`,
      mktViz:`<div class="xstats"><div class="xstat"><span class="xnum b">1</span><span class="xlbl">Campaign</span></div><div class="xstat"><span class="xnum g">6</span><span class="xlbl">Google channels</span></div><div class="xstat"><span class="xnum gr">Auto</span><span class="xlbl">Placement</span></div></div>`,
      ownViz:`<div class="xanalogy"><div class="xbig">👔</div><div class="xbig-name">The "All-Channel Manager"</div><div class="xbig-sub">One hire handles TV + radio + print + digital</div></div>`,
      eng:`Single campaign type serving across <strong>all Google inventory</strong>: Search, Shopping, Display, YouTube, Gmail, Discover, Maps. Uses <code>asset groups</code> (headlines, descriptions, images, videos, audience signals) and automates placement, bidding, and creative selection. Requires <span class="kw">conversion data</span> for optimization.`,
      mkt:`One campaign that <strong>runs your ads everywhere Google operates</strong> — search results, YouTube, Gmail, maps — and automatically shows the right format in the right place. You provide assets; <span class="metric">Google figures out where and how to show them.</span>`,
      own:`<span class="analogy-lede">Instead of hiring separate people for every channel...</span>You hire <strong>one manager who handles all channels at once</strong> and figures out which works best. That's PMax — one campaign, all of Google.`,
    },
    {
      id:"enhanced-conversions", label:"Enhanced Conversions",
      engViz:`<div class="xflow"><span class="xnode">Customer data<small>email · phone · name</small></span><span class="xarrow">→</span><span class="xnode xnode-hl">SHA-256 Hash<small>anonymised before sending</small></span><span class="xarrow">→</span><span class="xnode">Google match<small>signed-in account</small></span></div>`,
      mktViz:`<div class="xstats"><div class="xstat"><span class="xnum g">+15%</span><span class="xlbl">Measured conv.</span></div><div class="xstat"><span class="xnum b">Cross-device</span><span class="xlbl">Attribution</span></div><div class="xstat"><span class="xnum gr">No raw PII</span><span class="xlbl">Privacy-safe</span></div></div>`,
      ownViz:`<div class="xanalogy"><div class="xbig">💳</div><div class="xbig-name">The "Anonymous Loyalty Card"</div><div class="xbig-sub">Confirms identity without revealing it</div></div>`,
      eng:`First-party data matching: hashes customer-provided data (<code>email</code>, <code>phone</code>, <code>name</code>, <code>address</code>) via <strong>SHA-256</strong> before sending to Google. Google matches against signed-in accounts to improve conversion measurement accuracy, especially <span class="kw">cross-device and post iOS 14.5</span>.`,
      mkt:`When a customer buys, you send their <strong>hashed/anonymised email</strong> to Google. Google matches that to someone who clicked your ad — even if they switched devices or cleared cookies. <span class="metric">More accurate attribution</span>, no raw personal data shared.`,
      own:`<span class="analogy-lede">Like a loyalty card that's completely anonymous...</span>When someone buys from you, <strong>the card confirms they're the same person who saw your ad</strong> — without revealing who they are. More accurate tracking, better privacy.`,
    },
    {
      id:"first-party-data", label:"First-Party Data",
      engViz:`<div class="xflow"><span class="xnode">Your sources<small>CRM · transactions · app · email</small></span><span class="xarrow">→</span><span class="xnode xnode-hl">Google Ads<small>Customer Match · EC · PMax signals</small></span><span class="xarrow">→</span><span class="xnode">Better targeting<small>similar audiences · exclusions</small></span></div>`,
      mktViz:`<div class="xstats"><div class="xstat"><span class="xnum b">You own it</span><span class="xlbl">No data fees</span></div><div class="xstat"><span class="xnum g">Highest</span><span class="xlbl">Match quality</span></div><div class="xstat"><span class="xnum gr">Resilient</span><span class="xlbl">Cookie-proof</span></div></div>`,
      ownViz:`<div class="xanalogy"><div class="xbig">📇</div><div class="xbig-name">The "Referral Network"</div><div class="xbig-sub">Find new customers who look like your best ones</div></div>`,
      eng:`Data collected from <strong>your own touchpoints</strong>: CRM records, transaction history, email signups, app events, loyalty programs. Used via <code>Customer Match</code>, <code>Enhanced Conversions</code>, and as <span class="kw">audience signals in PMax</span>.`,
      mkt:`Your customer data — <strong>emails, purchase history, app users</strong> — used to target similar audiences on Google, exclude existing customers from acquisition, or re-engage lapsed buyers. <span class="metric">The most valuable targeting asset you own.</span>`,
      own:`<span class="analogy-lede">You've been collecting customer info for years...</span><strong>First-party data means using that list to find more people just like your best customers.</strong> It's like asking your best customers to refer friends who are similar to them.`,
    },
    {
      id:"audience-segments", label:"Audience Segments",
      engViz:`<div class="xtags"><span class="xtag b">In-Market</span><span class="xtag g">Affinity</span><span class="xtag y">Life Events</span><span class="xtag b">Custom Intent</span><span class="xtag g">RLSA</span><span class="xtag gr">Customer Match</span><span class="xtag gr">Similar</span></div>`,
      mktViz:`<div class="xstats"><div class="xstat"><span class="xnum b">Observation</span><span class="xlbl">Monitor only</span></div><div class="xstat"><span class="xnum g">Targeting</span><span class="xlbl">Restrict reach</span></div><div class="xstat"><span class="xnum gr">Bid adj.</span><span class="xlbl">Adjust bids</span></div></div>`,
      ownViz:`<div class="xanalogy"><div class="xbig">🎣</div><div class="xbig-name">Fish Where the Fish Are</div><div class="xbig-sub">Show your ad only to people who are actually interested</div></div>`,
      eng:`Cookie/user-ID groupings. Types: <code>Affinity</code> (interests), <code>In-Market</code> (active research), <code>Life Events</code>, <code>Custom Intent</code>, <code>Customer Match</code>, <code>Similar Segments</code>, <code>RLSA</code>. Use as <span class="kw">observation vs. targeting</span> or for bid adjustments.`,
      mkt:`Ways to group people by <strong>interests, behaviours, or brand relationship</strong>. Target "people researching flights" or "past visitors who didn't convert" — <span class="metric">increasing relevance and reducing wasted spend.</span>`,
      own:`<span class="analogy-lede">Instead of showing your ad to everyone...</span><strong>Show it only to people who searched for your type of product last week.</strong> Audience segments let you fish where the fish are.`,
    },
    {
      id:"dsa", label:"Dynamic Search Ads",
      engViz:`<div class="xflow"><span class="xnode">Google crawls<small>your website index</small></span><span class="xarrow">→</span><span class="xnode xnode-hl">Auto-matches<small>query → best page</small></span><span class="xarrow">→</span><span class="xnode">Dynamic headline<small>from page title</small></span></div>`,
      mktViz:`<div class="xstats"><div class="xstat"><span class="xnum b">0</span><span class="xlbl">Keywords needed</span></div><div class="xstat"><span class="xnum g">Long-tail</span><span class="xlbl">Queries captured</span></div><div class="xstat"><span class="xnum gr">Auto</span><span class="xlbl">Headline gen.</span></div></div>`,
      ownViz:`<div class="xanalogy"><div class="xbig">🧑‍💼</div><div class="xbig-name">The Self-Briefed Salesperson</div><div class="xbig-sub">Read your whole catalog — answers any customer question</div></div>`,
      eng:`Crawls your website to <strong>auto-generate headlines and match searches to landing pages</strong> — no keywords needed. Uses Google's index. Best for large-inventory sites. Control via <code>page feeds</code> or URL targeting. Pairs well with <span class="kw">RLSA</span>.`,
      mkt:`Google scans your website and <strong>automatically creates ads</strong> that match searchers to the most relevant page. <span class="metric">Captures long-tail searches you'd otherwise miss</span> — without writing keywords for every product.`,
      own:`<span class="analogy-lede">Imagine a salesperson who read your entire product catalog...</span>They can <strong>answer any customer question by pointing them to the right page</strong> — without you briefing them on every item.`,
    },
    {
      id:"rsa", label:"Responsive Search Ads",
      engViz:`<div class="xflow"><span class="xnode">15 headlines<br/>4 descriptions<small>you write</small></span><span class="xarrow">→</span><span class="xnode xnode-hl">ML tests<small>permutations per query</small></span><span class="xarrow">→</span><span class="xnode">Best combo<small>per context</small></span></div>`,
      mktViz:`<div class="xstats"><div class="xstat"><span class="xnum b">15</span><span class="xlbl">Max headlines</span></div><div class="xstat"><span class="xnum g">Auto A/B</span><span class="xlbl">Testing built-in</span></div><div class="xstat"><span class="xnum gr">Ad Strength</span><span class="xlbl">Quality signal</span></div></div>`,
      ownViz:`<div class="xanalogy"><div class="xbig">🎭</div><div class="xbig-name">The 15-Pitch Sales Team</div><div class="xbig-sub">Different pitch for every customer — only the best ones make calls</div></div>`,
      eng:`Ad format accepting up to <strong>15 headlines</strong> (30 chars) and <strong>4 descriptions</strong> (90 chars). Google's ML tests combinations and learns which permutations perform best per query, user, and context. <code>Ad strength</code> score indicates asset variety.`,
      mkt:`You write up to <strong>15 different headlines</strong> and Google tests combinations — automatically showing the version most likely to get clicked. <span class="metric">Better CTR without manual A/B testing.</span>`,
      own:`<span class="analogy-lede">Instead of printing one flyer...</span>You write 15 different headlines and <strong>Google picks the best combination for each customer</strong> based on what they searched. Like 15 salespeople with different pitches — the best ones make the calls.`,
    },
    {
      id:"quality-score", label:"Quality Score",
      engViz:`<div class="xstats"><div class="xstat"><span class="xnum b">Expected CTR</span><span class="xlbl">vs similar ads</span></div><div class="xstat"><span class="xnum g">Ad Relevance</span><span class="xlbl">keyword match</span></div><div class="xstat"><span class="xnum y">Landing Page</span><span class="xlbl">experience</span></div></div>`,
      mktViz:`<div class="xscale"><div class="xscale-bar"><div class="xscale-fill" style="width:80%"></div></div><div class="xscale-lbls"><span>1 — high CPC</span><span style="font-weight:700;color:#34a853">8/10 → lower CPC</span><span>10</span></div></div>`,
      ownViz:`<div class="xanalogy"><div class="xbig">🏆</div><div class="xbig-name">The Helpful Advertiser Reward</div><div class="xbig-sub">More relevant = cheaper clicks. Google rewards usefulness.</div></div>`,
      eng:`<strong>1–10 diagnostic metric</strong> (not directly used in auction). Components: <code>Expected CTR</code>, <code>Ad Relevance</code>, <code>Landing Page Experience</code>. Actual auction uses <span class="kw">Ad Rank = bid × Quality Score</span>. Higher QS → lower CPC for same position. Calculated at keyword level.`,
      mkt:`Google's <strong>1–10 relevance score</strong> for your ad and landing page. Higher score = <span class="metric">lower cost per click for the same position</span>. The shortcut: make your ad match the search, make your landing page match the ad.`,
      own:`<span class="analogy-lede">Google rewards advertisers who are genuinely helpful...</span><strong>High score = you pay less per click.</strong> Low score = you pay more, or your ad doesn't show. It's Google's way of keeping ads useful for searchers.`,
    },
    {
      id:"ad-rank", label:"Ad Rank",
      engViz:`<div class="xformula"><span class="xfp b">Bid</span><span class="xfop">×</span><span class="xfp g">Quality Score</span><span class="xfop">×</span><span class="xfp y">Extension impact</span><span class="xfop">+</span><span class="xfp gr">Context</span><div class="xformula-note">Calculated per auction · Dynamic every time</div></div>`,
      mktViz:`<div class="xstats"><div class="xstat"><span class="xnum b">≠ Highest bid</span><span class="xlbl">Always wins</span></div><div class="xstat"><span class="xnum g">Quality</span><span class="xlbl">Can beat budget</span></div><div class="xstat"><span class="xnum gr">Per auction</span><span class="xlbl">Dynamic</span></div></div>`,
      ownViz:`<div class="xanalogy"><div class="xbig">⚖️</div><div class="xbig-name">The Fair Auction</div><div class="xbig-sub">Relevance can beat a bigger budget</div></div>`,
      eng:`Real-time auction value. Formula: <code>Bid × Quality Score × Expected extension impact + context</code>. <strong>Calculated per auction</strong> — same ad can have different rank in different auctions. Top positions require minimum Ad Rank thresholds.`,
      mkt:`The score Google uses to decide which ads appear and in what order. <strong>It's not just about who bids highest</strong> — a relevant, high-quality ad can outrank a higher bid. <span class="metric">Improve quality to win the top spot without spending more.</span>`,
      own:`<span class="analogy-lede">It's not an auction where the highest bidder always wins...</span><strong>Google also considers whether your ad is actually useful to the searcher.</strong> Good relevance can beat a bigger budget — rewarding businesses that serve customers well.`,
    },
    {
      id:"attribution", label:"Attribution Models",
      engViz:`<div class="xpath"><span class="xpath-node">Ad 1<small>click</small></span><span class="xpath-line"></span><span class="xpath-node">Ad 2<small>click</small></span><span class="xpath-line"></span><span class="xpath-node xpath-conv">Convert 💰</span></div><div class="xpath-note">Who gets credit? — depends on model</div>`,
      mktViz:`<div class="xstats"><div class="xstat"><span class="xnum gr">Last click</span><span class="xlbl">100% to last ad</span></div><div class="xstat"><span class="xnum g">Data-driven</span><span class="xlbl">ML splits credit</span></div><div class="xstat"><span class="xnum b">Affects</span><span class="xlbl">Smart Bidding</span></div></div>`,
      ownViz:`<div class="xanalogy"><div class="xbig">🏀</div><div class="xbig-name">Assist vs. Score</div><div class="xbig-sub">Did the first pass or the final shot win the game?</div></div>`,
      eng:`Method for assigning conversion credit across touchpoints. Models: <code>Last Click</code>, <code>First Click</code>, <code>Linear</code>, <code>Time Decay</code>, <code>Position-Based</code>, <code>Data-Driven</code> (300+ conv/30 days). <span class="kw">DDA uses ML</span> for fractional credit. Directly impacts Smart Bidding signals.`,
      mkt:`How you decide <strong>which ad gets credit</strong> when a customer clicks multiple ads before converting. Last-click gives 100% to the final ad. Data-driven shares credit based on which touchpoints <span class="metric">actually influenced the sale</span>. Affects where Smart Bidding allocates budget.`,
      own:`<span class="analogy-lede">If a customer sees your ad three times before buying...</span><strong>Which ad gets the credit?</strong> Attribution models answer this. Like a basketball assist — the answer changes how you invest your budget.`,
    },
    {
      id:"conversion-tracking", label:"Conversion Tracking",
      engViz:`<div class="xflow"><span class="xnode">User action<small>purchase · form · call</small></span><span class="xarrow">→</span><span class="xnode xnode-hl">gtag.js / GTM<small>fires conversion tag</small></span><span class="xarrow">→</span><span class="xnode">Google Ads<small>records + optimises</small></span></div>`,
      mktViz:`<div class="xstats"><div class="xstat"><span class="xnum r">No tracking</span><span class="xlbl">= Blind bidding</span></div><div class="xstat"><span class="xnum g">With tracking</span><span class="xlbl">Smart Bidding works</span></div><div class="xstat"><span class="xnum b">Priority #1</span><span class="xlbl">Foundation</span></div></div>`,
      ownViz:`<div class="xanalogy"><div class="xbig">🧾</div><div class="xbig-name">The Connected Cash Register</div><div class="xbig-sub">Google learns which ads make you money — and doubles down on them</div></div>`,
      eng:`Event measurement via <code>gtag.js</code> or <code>GTM</code>. Tracks: purchases, form submits, phone calls, app installs. Server-side via <code>Conversion API</code>. Key config: <span class="kw">conversion window, value, count (one/all)</span>. <strong>Required for Smart Bidding.</strong>`,
      mkt:`The system that tells Google when a valuable action happens — <strong>a sale, a lead form, a phone call</strong>. Without it, Smart Bidding has no signal to optimise toward. <span class="metric">Accurate conversion tracking is the foundation of every high-performing campaign.</span>`,
      own:`<span class="analogy-lede">Your cash register, connected to your ads...</span>When someone buys after clicking your ad, conversion tracking tells Google "that ad worked." <strong>Without it, Google is flying blind</strong> — it can't learn which ads are making you money.`,
    },
    {
      id:"broad-match", label:"Broad Match",
      engViz:`<div class="xstats"><div class="xstat"><span class="xnum b">🎯 Exact</span><span class="xlbl">Spear fishing</span></div><div class="xstat"><span class="xnum g">🌐 Broad</span><span class="xlbl">Net fishing</span></div><div class="xstat"><span class="xnum gr">+ Smart Bidding</span><span class="xlbl">Keeps best fish</span></div></div>`,
      mktViz:`<div class="xstats"><div class="xstat"><span class="xnum g">Expands</span><span class="xlbl">Synonyms + intent</span></div><div class="xstat"><span class="xnum b">Discovers</span><span class="xlbl">New queries</span></div><div class="xstat"><span class="xnum gr">Lowest CPA</span><span class="xlbl">at scale</span></div></div>`,
      ownViz:`<div class="xanalogy"><div class="xbig">🌊</div><div class="xbig-name">The Smart Fishing Net</div><div class="xbig-sub">Catches more — Smart Bidding releases the ones not worth keeping</div></div>`,
      eng:`Match type expanding to <strong>semantically related queries</strong>: synonyms, misspellings, related searches, paraphrases. Uses query-user context: user history, landing page content, ad group keywords. <span class="kw">Performs best with Smart Bidding + audience data.</span>`,
      mkt:`Your keyword matches a <strong>much wider range of searches</strong> — including ones you'd never think to add manually. Combined with Smart Bidding, <span class="metric">it finds converting queries you'd miss with Exact or Phrase Match</span>. Often delivers the lowest CPA at scale.`,
      own:`<span class="analogy-lede">Exact Match is fishing with a spear — you only catch what you aim at...</span><strong>Broad Match is a net</strong> — catches more fish, including ones you didn't know were nearby. With Smart Bidding, it only keeps the fish worth keeping.`,
    },
    {
      id:"roas", label:"ROAS",
      engViz:`<div class="xformula"><span class="xfp g">Revenue</span><span class="xfop">÷</span><span class="xfp b">Ad Spend</span><span class="xfop">×</span><span class="xfp gr">100</span><span class="xfop">=</span><span class="xfp y">ROAS %</span><div class="xformula-note">400% = $4 revenue per $1 spent</div></div>`,
      mktViz:`<div class="xstats"><div class="xstat"><span class="xnum b">$100</span><span class="xlbl">Ad spend</span></div><div class="xstat"><span class="xnum g">$400</span><span class="xlbl">Revenue</span></div><div class="xstat"><span class="xnum y">400%</span><span class="xlbl">ROAS</span></div></div>`,
      ownViz:`<div class="xanalogy"><div class="xbig">🧮</div><div class="xbig-name">The Vending Machine Test</div><div class="xbig-sub">Put $1 in — do you get $4 out? Stop when the math breaks.</div></div>`,
      eng:`<code>Conversion value ÷ ad spend × 100</code>. <strong>Target ROAS</strong> is a Smart Bidding strategy optimising bids toward a revenue-to-spend ratio. Requires <span class="kw">50+ conversions</span> recommended. Works at campaign or portfolio level.`,
      mkt:`For every dollar spent on ads, how many dollars in revenue do you get back. <strong>400% ROAS = $4 revenue per $1 spent.</strong> Target ROAS tells Google: <span class="metric">"keep spending as long as I'm getting at least $4 back for every $1."</span>`,
      own:`<span class="analogy-lede">Simple math: spend $100 on ads, make $400 in sales = 400% ROAS...</span><strong>Target ROAS tells Google: keep spending as long as the math works.</strong> Stop when it doesn't.`,
    },
    {
      id:"customer-match", label:"Customer Match",
      engViz:`<div class="xflow"><span class="xnode">Your list<small>email · phone · name</small></span><span class="xarrow">→</span><span class="xnode xnode-hl">SHA-256 hash<small>uploaded securely</small></span><span class="xarrow">→</span><span class="xnode">Google matches<small>30–60% match rate</small></span></div>`,
      mktViz:`<div class="xstats"><div class="xstat"><span class="xnum b">Target</span><span class="xlbl">Known customers</span></div><div class="xstat"><span class="xnum r">Exclude</span><span class="xlbl">Already buyers</span></div><div class="xstat"><span class="xnum g">Similar</span><span class="xlbl">Lookalike audiences</span></div></div>`,
      ownViz:`<div class="xanalogy"><div class="xbig">📬</div><div class="xbig-name">Digital Direct Mail</div><div class="xbig-sub">Reach your exact customer list online — no printing cost</div></div>`,
      eng:`Upload hashed PII (<code>email</code>, <code>phone</code>, <code>first/last name</code>) to Google Ads. Google matches to signed-in accounts. Target/exclude across Search, Shopping, Display, Gmail, YouTube. Match rates: <strong>30–60%</strong>. Requires <span class="kw">1,000+ matched users</span> for targeting.`,
      mkt:`Upload your <strong>existing customer email list</strong> to Google. Google finds those people online — target them with a re-engagement offer or <span class="metric">exclude them from acquisition to avoid wasting budget on people who already bought.</span>`,
      own:`<span class="analogy-lede">You give Google your customer list (safely anonymised)...</span>Google finds those <strong>exact people when they're on YouTube, Gmail, or searching</strong> — so you can show them a special offer. Like direct mail, but digital.`,
    },
    {
      id:"gtm", label:"Google Tag Manager",
      engViz:`<div class="xflow"><span class="xnode">Container snippet<small>1 tag on site</small></span><span class="xarrow">→</span><span class="xnode xnode-hl">GTM UI<small>tags · triggers · variables</small></span><span class="xarrow">→</span><span class="xnode">All tracking<small>no code deploy</small></span></div>`,
      mktViz:`<div class="xstats"><div class="xstat"><span class="xnum g">0 tickets</span><span class="xlbl">Dev requests</span></div><div class="xstat"><span class="xnum b">Version</span><span class="xlbl">History + rollback</span></div><div class="xstat"><span class="xnum gr">Debug mode</span><span class="xlbl">Preview first</span></div></div>`,
      ownViz:`<div class="xanalogy"><div class="xbig">🎛️</div><div class="xbig-name">The Control Panel</div><div class="xbig-sub">Marketing turns tracking on/off — no programmer needed</div></div>`,
      eng:`Tag management system using a <code>container snippet</code> (async JS) on-site. Manages tag firing via <strong>triggers and variables</strong> without code deploys. Supports server-side containers (<code>GTM Server</code>). Features: version history, debug mode, built-in Google tag templates.`,
      mkt:`A tool that lets you <strong>add or update tracking code on your website without asking a developer</strong>. Add conversion tracking, analytics, A/B test tools via a simple interface. <span class="metric">Faster iterations, fewer IT tickets.</span>`,
      own:`<span class="analogy-lede">Your website has many different measurement tools...</span><strong>GTM is the control panel where your marketing team can turn them on or off</strong> — without needing a programmer. It saves weeks of development time.`,
    },
  ];

  let active = 0;

  function renderChips() {
    const row = document.getElementById("ex-chip-row");
    if (!row) return;
    row.innerHTML = "";
    concepts.forEach((c, i) => {
      const btn = document.createElement("button");
      btn.className = "ex-chip" + (i === active ? " ex-chip-on" : "");
      btn.textContent = c.label;
      btn.addEventListener("click", () => { active = i; renderChips(); renderCards(); });
      row.appendChild(btn);
    });
  }

  function renderCards() {
    const c = concepts[active];
    document.getElementById("ex-viz-eng").innerHTML = c.engViz;
    document.getElementById("ex-viz-mkt").innerHTML = c.mktViz;
    document.getElementById("ex-viz-own").innerHTML = c.ownViz;
    document.getElementById("ex-body-eng").innerHTML = `<p>${c.eng}</p>`;
    document.getElementById("ex-body-mkt").innerHTML = `<p>${c.mkt}</p>`;
    document.getElementById("ex-body-own").innerHTML = `<p>${c.own}</p>`;
  }

  renderChips();
  renderCards();
</script>
